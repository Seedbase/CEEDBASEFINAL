                                    </div>
									<div class="mdl-card__menu">
								    	<button id="add-a-new-skill-button" class="mdl-button mdl-button--icon mdl-js-button mdl-js-ripple-effect">
								      		<i class="material-icons">add</i>
									    </button>
								  	</div>
                                </div>
                            </div>
                        </div>

                        <div class="row card-block">
							<div class="col-sm-12">
                                <div class="mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">Projects</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text">
                                        <div class="row">
                                            <div class="col-sm-12 col-md-12 col-lg-12">
                                                <!-- Project Template -->
                                                <div class="project-item timeline-item hover-component hide-content" id="project-template">
                                                    <div class="main-content">
                                                        <span class="material-icons" data-badge=""><h4 class="item-title"></h4></span>
                                                        <div class="item-edit">
                                                            <a class="edit-project-button"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                                                            <%# <a class="remove-content"><i class="fa fa-remove" aria-hidden="true"></i></a>%>
                                                        </div>
                                                        <span class="item-period"></span>
                                                        <p class="item-description"></p>
                                                    </div>
													<dialog class="mdl-dialog editable-content">
														<h4 class="mdl-dialog__title">Edit Project</h4>
														<div class="mdl-dialog__close">
															<button class="mdl-button mdl-button--icon mdl-js-button mdl-js-ripple-effect close">
																<i class="material-icons">close</i>
															</button>
														</div>
														<div class="mdl-dialog__content">
															<div class="row">
	                                                            <div class="col-sm-12">
	                                                                <div class="mdl-textfield template-shield-mdl-js-textfield mdl-textfield--floating-label full-width">
	                                                                    <input class="mdl-textfield__input project-title-content" type="text" id="">
	                                                                    <label class="mdl-textfield__label" for="">Project Title</label>
	                                                                </div>
	                                                            </div>
	                                                            <div class="col-sm-12">
	                                                                <div class="row input-date-group-template">
	                                                                    <div class="col-sm-5">
	                                                                        <div class="mdl-textfield template-shield-mdl-js-textfield mdl-textfield--floating-label">
	                                                                            <input class="mdl-textfield__input year project-date-from-content" placeholder="yyyy" pattern="-?[0-9]*(\.[0-9]+)?" type="text" id="">
	                                                                            <label class="mdl-textfield__label" for="">From</label>
	                                                                            <span class="mdl-textfield__error">Input is not a number!</span>
	                                                                        </div>
	                                                                    </div>
	                                                                    <div class="col-sm-5">
	                                                                        <div class="mdl-textfield template-shield-mdl-js-textfield mdl-textfield--floating-label">
	                                                                            <input class="mdl-textfield__input year project-date-to-content" type="text" pattern="-?[0-9]*(\.[0-9]+)?" placeholder="yyyy" id="">
	                                                                            <label class="mdl-textfield__label" for="">To</label>
	                                                                            <span class="mdl-textfield__error">Input is not a number!</span>
	                                                                        </div>
	                                                                    </div>
	                                                                </div>
	                                                            </div>
