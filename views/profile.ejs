                    </div>
                </dialog>
            </div>
        </script>

        <script>
            var user = JSON.parse($('#userProfileObject').text());
            var userId = user._id;
            $(document).ready(function() {
                var videoUploader = new qq.FineUploader({
                    element: document.getElementById("profile-video-uploader"),
                    template: 'qq-template',
                    debug: false,
                    multiple: false,
                    session: {
                        endpoint: '/api/profile/video/upload/fetch/' + userId
                    },
                    request: {
                        customHeaders: {},
                        endpoint: "/api/profile/video/upload",
                        filenameParam: "qqfilename",
                        filenameParamName: 'video',
                        forceMultipart: true,
                        inputName: "profileVideo",
                        method: "POST",
                        params: {},
                        paramsInBody: true,
                        totalFileSizeName: "qqtotalfilesize",
                        uuidName: "qquuid"
                    },
                    thumbnails: {
                        placeholders: {
                          notAvailablePath: "images/fineuploader/default-thumb.jpg"
                        }
                    },
                    validation: {
                        allowedExtensions: ['webm', 'mkv', 'flv', 'mp3', 'mp4', 'vob', 'ogv', 'ogg', 'drc', 'gif',
                                            'gifv', 'mng', 'avi', 'mov', 'qt', 'wmv', 'yuv', 'rm', 'rmvb', 'asf',
                                            'amv', 'm4p', 'm4v', 'mpg', 'mp2', 'mpeg', 'mpe', 'mpv', 'mpg', 'mpeg',
                                            'm2v', 'm4v', 'svi', '3gp', '3g2', 'mxf', 'roq', 'nsv', 'nsv', 'f4v',
                                            'f4p', 'f4a', 'f4b'],
                        minSizeLimit: 0,
                        stopOnFirstInvalidFile: false
                    },
                    callbacks: {
                        onComplete: function(id, name, responseJSON, maybeXhr) {
                            var fileObject = {uuid: responseJSON.newUuid, size: responseJSON.size, name: responseJSON.name, url: responseJSON.url};
                            $('#videoResume').text(JSON.stringify(fileObject));

                        },
                        onError: function (id, name, reason, maybeXhrOrXdr) {
                            /*angular.element('#product-photo-uploader').scope().showImageUploadErrors(reason);*/
                        },
                        onSessionRequestComplete: function(response, success, xhrOrXdr) {

                        }
                    }
                });
            });
        </script>
