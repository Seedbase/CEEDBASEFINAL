            // For region dropdown
            $(document).ready(function() {
                $('#creativeRegion').select2({
                    data: ['', 'Barrie', 'Bay of Quinte', 'Bow Valley', 'Calgary', 'Charlottetown', 'Comox Valley',
                        'Durham Region', 'Edmonton', 'Fredericton', 'Halifax', 'Hamilton', 'Kamloops', 'Kingston', 'Montreal',
                        'Nanaimo', 'Nelson', 'Niagara Falls', 'Ottawa', 'Ottawa Valley', 'Peel Region', 'Peterborough',
                        'Prince George', 'Revelstoke', 'Sarnia Lambton', 'Saskatoon', 'Sault Ste Marie', 'Smithers', 'Toronto',
                        'Vancouver', 'Waterloo', 'Whitehorse', 'Windsor', 'Winnipeg', 'York Region'],
                    placeholder: function () {
                        $(this).data('placeholder');
                    }
                });

                $(".skill-range").ionRangeSlider({
                    min: 10,
                    max: 100
                });

                $('.icp-auto').iconpicker({
                    placement:'bottomLeft'
                });

                $('.portfolio-container').pajinate({
                    items_per_page : 3,
                    item_container_id : '#portfolio',
                    nav_panel_id : '.pagination-container ul',
                    show_first_last: false
                });

            });

            $('.add-button').on('click', function() {
                var supportingText = $(this).parents('.mdl-card__supporting-text');
                var content = $(supportingText).find('#add-a-skill');
                var showButton = $(supportingText).find('.show-content-button');
                $(content).removeClass('hide-content');
                //$(showButton).addClass('hide-content');
            });

            $('.edit-content').on('click', function() {
                var mainContent = $(this).parents('.main-content');
                var editableContent = $(mainContent).siblings('.editable-content');
                $(mainContent).addClass('hide-content');
                $(editableContent).removeClass('hide-content');
            });

            $('.save-content, .cancel-content').on('click', function() {
                var editableContent = $(this).parents('.editable-content');
                var mainContent = $(editableContent).siblings('.main-content');
                $(editableContent).addClass('hide-content');
                $(mainContent).removeClass('hide-content');
            });


            //For mm/yy component
            jQuery('.input-date-group .mnth').datepicker({
                autoclose: true,
                minViewMode: 1,
                format: "mm/yyyy"
            });

            $('#content').on( 'change keyup keydown paste cut', 'textarea', function (){
                $(this).height(0).height(this.scrollHeight);
            }).find( 'textarea' ).change();
        </script>

