<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="">
        <meta name="author" content="CSSLoss.com">
        <link rel="icon" href="img/favicon.ico">
        <title>CeedBase</title>

        <!-- BOOTSTRAP CORE CSS -->
        <link rel="stylesheet" href="css/vendor/bootstrap.min.css">

        <!-- Styles for Canvas Template -->
        <link rel="stylesheet" href="css/style-updated.css" type="text/css" />
        <link rel="stylesheet" href="css/dark.css" type="text/css" />
        <link rel="stylesheet" href="css/font-icons.css" type="text/css" />
        <link rel="stylesheet" href="css/animate.css" type="text/css" />
        <link rel="stylesheet" href="css/responsive.css" type="text/css" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Canvas Components CSS -->
        <link rel="stylesheet" href="css/canvas-components/datepicker.css" type="text/css" />
        <link rel="stylesheet" href="css/canvas-components/radio-checkbox.css" type="text/css" />
        <link rel="stylesheet" href="css/canvas-components/ion.rangeslider.css" type="text/css" />
        <link rel="stylesheet" href="css/canvas-components/bs-filestyle.css" type="text/css" />

        <!-- Google Material Design Lite CSS -->
        <link rel="stylesheet" href="css/mdl/material.min.css" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

        <link href="plugins/select2/dist/css/select2.min.css" rel="stylesheet"/>
        <link rel="stylesheet" href="css/font-awesome.min.css"/>
        <link rel="stylesheet" href="css/fontawesome-iconpicker.min.css"/>

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.theme.min.css">
        <link rel="stylesheet" type="text/css" media="screen" href="http://ajax.googleapis.com/ajax/libs/jqueryui/1.7.2/themes/base/jquery-ui.css">
        <link href="plugins/fine-uploader/fine-uploader/fine-uploader-gallery.min.css" rel="stylesheet">
        <link href="plugins/fine-uploader/fine-uploader/fine-uploader.min.css" rel="stylesheet">

        <!-- Custom CSS -->
        <link rel="stylesheet" href="css/profile.css" />

    </head>

    <body class="stretched">
        <!-- LOADER -->
        <div class="loader-wrapper">
            <div class="loader"></div>
        </div>

        <div style="display: none">
            <%if (user.provider == 'google') { %>
            <input id="providerId" type="text" value="<%= user.google.id %>">
            <% } %>
            <%if (user.provider == 'facebook') { %>
            <input id="providerId" type="text" value="<%= user.facebook.id %>">
            <% } %>
            <%if (user.provider == 'linkedin') { %>
            <input id="providerId" type="text" value="<%= user.linkedIn.id %>">
            <% } %>
            <%if (user.provider == 'twitter') { %>
            <input id="providerId" type="text" value="<%= user.twitter.id %>">
            <% } %>

            <p id="videoResume"></p>

            <p id="userProfileObject"> <%= JSON.stringify(user) %> </p>
        </div>

        <div id="wrapper" class="clearfix">
            <section id="intro" class="clearfix section notopborder nomargin">
                <div class="container input-date-group">
                    <div class="row">
                        <div id="intro-img" class="col-md-3">
                            <div class="img-container" style="min-width: 250px; max-width: 250px;">
                                <img src="<%= user.image %>" class="center-content" alt="Avatar">
                            </div>

                        </div>
                        <div id="intro-profile" class="col-md-9 reduce-padding">
                            <div class="row form-horizontal">
                                <div class="col-sm-6"><h4 class="custom-heading">Hello, I'm</h4></div>
                                <div class="col-sm-12">
                                    <div class="mdl-textfield mdl-js-textfield full-width profile-name">
                                        <input class="mdl-textfield__input" type="text" id="introText1" value="<%= user.displayName %>">
                                        <label class="mdl-textfield__label" for="introText1">Full Name</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-5-custom">
                                    <div class="mdl-textfield mdl-js-textfield full-width">
                                        <input class="mdl-textfield__input" type="text" id="introText2" value="<%= (user.profile && user.profile.introText) ? user.profile.introText[1] : '' %>">
                                        <label class="mdl-textfield__label" for="introText2">Designer</label>
                                    </div>
                                </div>
                                <div class="col-sm-1">and</div>
                                <div class="col-sm-5-custom">
                                    <div class="mdl-textfield mdl-js-textfield full-width">
                                        <input class="mdl-textfield__input" type="text" id="introText3" value="<%= (user.profile && user.profile.introText) ? user.profile.introText[2] : '' %>">
                                        <label class="mdl-textfield__label" for="introText3">Designer</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row topmargin-sm">
                                <div class="col-sm-12">
                                    <label>Opportunities I&#39;m seeking</label>
                                    <div class="row">
                                        <div class="col-lg-3 col-md-6 col-sm-6">
                                            <input id="unPaidInternship" class="radio-style" name="opportunityOption" type="radio" value="unPaidInternship">
                                            <label for="unPaidInternship" class="radio-style-3-label radio-small radio-button-label">Unpaid Internship</label>
                                        </div>
                                        <div class="col-lg-3 col-md-6 col-sm-6">
                                            <input id="paidInternship" class="radio-style" name="opportunityOption" type="radio" value="paidInternship">
                                            <label for="paidInternship" class="radio-style-3-label radio-small radio-button-label">Paid internship</label>
                                        </div>
                                        <div class="col-lg-3 col-md-6 col-sm-6">
                                            <input id="tempContract" class="radio-style" name="opportunityOption" type="radio" value="tempContract">
                                            <label for="tempContract" class="radio-style-3-label radio-small radio-button-label">Temporary Contract</label>
                                        </div>
                                        <div class="col-lg-3 col-md-6 col-sm-6">
                                            <input id="fullTimeHire" class="radio-style" name="opportunityOption" type="radio" value="fullTimeHire">
                                            <label for="fullTimeHire" class="radio-style-3-label radio-small radio-button-label">Full Time Hire</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row topmargin-sm">
                                <div class="col-sm-12">
                                    <label>Video Resume</label>
                                    <div id="profile-video-uploader"></div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>

            <div id="content" style="background-color: #F9F9F9;">
                <div id="content-wrap">
                    <div class="container clearfix" style="margin: 40px auto; padding: 0 20px;">

                        <div class="row card-block">
                            <div class="col-sm-12">
                                <div class="demo-card-wide mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">About Me</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text input-date-group">
                                        <div class="row">
                                            <div class="col-sm-5">
                                                <div class="form-horizontal row">
                                                    <div class="col-sm-4">
                                                        <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label">
                                                            <input name="birthday" id="birthday" type="text" pattern="-?[0-9]*(\.[0-9]+)?" value="<%= user.profile ? user.profile.birthday : '' %>" class="mdl-textfield__input tleft mnth" placeholder="mm/yyyy">
                                                            <label class="mdl-textfield__label" for="birthday">Birthday</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-8 col-sm-9">
                                                        <label class="custom-mdl-textfield__label" for="creativeRegion" style="">Region</label>
                                                        <select id="creativeRegion" class="form-control select2-element" data-placeholder="Select a region">
                                                        </select>
                                                    </div>
                                                    <div class="col-sm-12">
                                                        <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label full-width">
                                                            <input class="mdl-textfield__input" type="email" id="email" value="<%= user.email %>">
                                                            <label class="mdl-textfield__label" for="email">Email</label>
                                                            <span class="mdl-textfield__error">Input does not have the correct format!</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-6">
                                                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label" style="width: 90%;">
                                                    <textarea class="mdl-textfield__input autoresize" type="text" rows="1" id="passion" maxlength="200" style="overflow: hidden; max-width:100%;"><%= user.profile ? user.profile.passion : '' %></textarea>
                                                    <label class="mdl-textfield__label" for="passion">Describe your passion</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row card-block">
                            <div class="col-sm-12">
                                <div class="mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">Skills</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text input-date-group">

                                        <!-- Skill Template -->
                                        <div class="skill-item col-sm-6 hover-component hide-content" id="skill-template">
                                            <div class="main-content">
                                                <div class="row">
                                                    <div class="col-sm-10">
                                                        <span id="skill-title" class="mdl-badge skill-title" data-badge="0"></span>
                                                        <li data-percent="">
                                                            <div class="progress nopadding">
                                                                <div class="progress-percent">
                                                                    <div class="counter counter-inherit">
                                                                        <span id="skill-range" class="skill-range" data-from="0" data-to="" data-refresh-interval="30" data-speed="1100"></span>%
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </li>
                                                    </div>
                                                    <div class="col-sm-2">
                                                        <a class="edit-content"><i class="fa fa-pencil fa-lg" aria-hidden="true"></i></a>
                                                        <a class="remove-content"><i class="fa fa-remove fa-lg" aria-hidden="true"></i></a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="editable-content hide-content">
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <div class="template-shield-mdl-textfield template-shield-mdl-js-textfield template-shield-mdl-textfield--floating-label full-width">
                                                            <input id="skill-title-input" class="template-shield-mdl-textfield__input" type="text" value="" maxlength="40" />
                                                            <label class="template-shield-mdl-textfield__label" for="skill-title-input">Skill Name</label>
                                                            <span class="template-shield-mdl-textfield__error">Skill name must be defined!</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <div>
                                                            <input id="skill-rating-input" name="skill-rating-input" value="" class="skill-range-slider-template" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-12 padding-15">
                                                        <button class="template-shield-mdl-button template-shield-mdl-js-button template-shield-mdl-button--raised save-skill-button" style="margin-right: 8px;">
                                                            Save
                                                        </button>
                                                        <button class="template-shield-mdl-button template-shield-mdl-js-button template-shield-mdl-button--raised cancel-skill-button">
                                                            Cancel
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <ul class="skills row nopadding">

                                            <!-- Existing skills -->
                                            <% if (user.profile && user.profile.skills ) { %>
                                                <% for (var i = 1; i <= user.profile.skills.length; i++) {%>
                                                    <div class="skill-item col-sm-6 hover-component" id="skill<%=i%>">
                                                        <div class="main-content">
                                                            <div class="row">
                                                                <div class="col-sm-10">
                                                                    <span id="skill-title" class="mdl-badge skill-title" data-badge="0"><%=user.profile.skills[i].skill%></span>
                                                                    <li data-percent="<%=user.profile.skills[i].rating%>">
                                                                        <div class="progress nopadding">
                                                                            <div class="progress-percent">
                                                                                <div class="counter counter-inherit">
                                                                                    <span id="skill-range" class="skill-range" data-from="0" data-to="<%=user.profile.skills[i].rating%>" data-refresh-interval="30" data-speed="1100"></span>%
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </li>
                                                                </div>
                                                                <div class="col-sm-2">
                                                                    <a class="edit-content"><i class="fa fa-pencil fa-lg" aria-hidden="true"></i></a>
                                                                    <a class="remove-content"><i class="fa fa-remove fa-lg" aria-hidden="true"></i></a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="editable-content hide-content">
                                                            <div class="row">
                                                                <div class="col-sm-12">
                                                                    <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label full-width">
                                                                        <input id="skill-title-input" class="mdl-textfield__input" type="text" value="<%=user.profile.skills[i].skill%>"/>
                                                                        <label class="mdl-textfield__label" for="skill-title-input">Skill Name</label>
                                                                        <span class="mdl-textfield__error">Skill name must be defined!</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="row">
                                                                <div class="col-sm-12">
                                                                    <div>
                                                                        <input id="skill-rating-input" name="skill-rating-input" class="skill-range-slider" value="<%=user.profile.skills[i].rating%>" />
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="row">
                                                                <div class="col-sm-12 padding-15">
                                                                    <button class="mdl-button mdl-js-button mdl-button--raised update-skill-button" style="margin-right: 8px;">
                                                                        Update
                                                                    </button>
                                                                    <button class="mdl-button mdl-js-button mdl-button--raised cancel-skill-button">
                                                                        Cancel
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            <% } %>
                                        </ul>
                                        <div class="row show-content-button">
                                            <div class="col-sm-2">
                                                <button id="add-a-new-skill-button" class="mdl-button mdl-js-button mdl-button--raised add-button">
                                                    Add
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row row-eq-height hide-content topmargin-sm add-button-content" id="add-a-skill">
                                            <div class="col-sm-5">
                                                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label full-width">
                                                    <input class="mdl-textfield__input" type="text" id="skill-name" value="" maxlength="40">
                                                    <label class="mdl-textfield__label" for="skill-name">Skill Name</label>
                                                    <span class="mdl-textfield__error">Skill name must be defined!</span>
                                                </div>
                                            </div>
                                            <div class="col-sm-3">
                                                <div style="position: absolute; bottom: 20px; width: 95%;">
                                                    <input id="skill-rating-content" name="skill-rating-content" class="skill-range-slider" value="10" />
                                                </div>
                                            </div>
                                            <div class="col-sm-3 col-sm-offset-1">
                                                <button id="add-a-skill-button" class="mdl-button mdl-js-button mdl-button--raised save-content" style="margin-right: 8px;">
                                                    Add
                                                </button>
                                                <button id="cancel-a-skill-button" class="mdl-button mdl-js-button mdl-button--raised cancel-content">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row card-block">
                            <div class="col-sm-12">
                                <div class="mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">Certifications</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row card-block">
                            <div class="col-sm-6">
                                <div class="mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">Projects</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text">
                                        <div class="row">
                                            <div class="col-sm-12 col-md-12 col-lg-12">
                                                <!-- Project Template -->
                                                <div class="project-item timeline-item hover-component hide-content" id="project-template">
                                                    <div class="main-content">
                                                        <h4 class="item-title"></h4>
                                                        <div class="item-edit">
                                                            <a class="edit-content"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                                                            <a class="remove-content"><i class="fa fa-remove" aria-hidden="true"></i></a>
                                                        </div>
                                                        <span class="item-period"></span>
                                                        <p class="item-description"></p>
                                                    </div>
                                                    <div class="editable-content hide-content">
                                                        <div class="row">
                                                            <div class="col-sm-12">
                                                                <div class="template-shield-mdl-textfield template-shield-mdl-js-textfield template-shield-mdl-textfield--floating-label full-width">
                                                                    <input class="template-shield-mdl-textfield__input project-title-content" type="text" id="">
                                                                    <label class="template-shield-mdl-textfield__label" for="">Project Title</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-12">
                                                                <div class="row input-date-group-template">
                                                                    <div class="col-sm-5">
                                                                        <div class="template-shield-mdl-textfield template-shield-mdl-js-textfield template-shield-mdl-textfield--floating-label">
                                                                            <input class="template-shield-mdl-textfield__input year project-date-from-content" placeholder="yyyy" pattern="-?[0-9]*(\.[0-9]+)?" type="text" id="">
                                                                            <label class="template-shield-mdl-textfield__label" for="">From</label>
                                                                            <span class="template-shield-mdl-textfield__error">Input is not a number!</span>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-sm-5">
                                                                        <div class="template-shield-mdl-textfield template-shield-mdl-js-textfield template-shield-mdl-textfield--floating-label">
                                                                            <input class="template-shield-mdl-textfield__input year project-date-to-content" type="text" pattern="-?[0-9]*(\.[0-9]+)?" placeholder="yyyy" id="">
                                                                            <label class="template-shield-mdl-textfield__label" for="">To</label>
                                                                            <span class="template-shield-mdl-textfield__error">Input is not a number!</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-12">
                                                                <div class="template-shield-mdl-textfield template-shield-mdl-js-textfield template-shield-mdl-textfield--floating-label full-width">
                                                                    <textarea class="template-shield-mdl-textfield__input autoresize project-desc-content" type="text" rows= "1" id=""></textarea>
                                                                    <label class="template-shield-mdl-textfield__label" for="">Description</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-sm-12 padding-15">
                                                                <button id="" class="template-shield-mdl-button template-shield-mdl-js-button template-shield-mdl-button--raised save-project-button" style="margin-right: 8px;">
                                                                    Save
                                                                </button>
                                                                <button id="" class="template-shield-mdl-button template-shield-mdl-js-button template-shield-mdl-button--raised cancel-project-button">
                                                                    Cancel
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div id="project-timeline" class="timeline hide-content">
                                                    <% if (user.profile && user.profile.experiences) {%>
                                                        <% for (var i = 1; i <= user.profile.experiences.length; i++) {%>
                                                            <div class="project-item timeline-item" id="project<%=i%>">
                                                                <div class="main-content">
                                                                    <h4 class="item-title"><%= user.profile.experiences[i].title%></h4>
                                                                    <div class="item-edit">
                                                                        <a class="edit-content"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                                                                        <a class="remove-content"><i class="fa fa-remove" aria-hidden="true"></i></a>
                                                                    </div>
                                                                    <div class="item-edit">
                                                                        <a><i class="fa fa-pencil" aria-hidden="true"></i></a>
                                                                        <a><i class="fa fa-remove" aria-hidden="true"></i></a>
                                                                    </div>
                                                                    <span class="item-period"><%= user.profile.experiences[i].from %> - <%= user.profile.experiences[i].to %></span>
                                                                    <p class="item-description"><%= user.profile.experiences[i].description %></p>
                                                                </div>
                                                                <div class="editable-content hide-content">
                                                                    <div class="row">
                                                                        <div class="col-sm-12">
                                                                            <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label full-width">
                                                                                <input class="mdl-textfield__input project-title-content" type="text" id="project-title<%=i%>">
                                                                                <label class="mdl-textfield__label" for="project-title<%=i%>">Project Title</label>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-sm-12">
                                                                            <div class="row input-date-group">
                                                                                <div class="col-sm-5">
                                                                                    <div class="mdl-textfield template-shield-mdl-js-textfield template-shield-mdl-textfield--floating-label">
                                                                                        <input class="template-shield-mdl-textfield__input year project-date-from-content" placeholder="yyyy" pattern="-?[0-9]*(\.[0-9]+)?" type="text" id="project-date-from<%=i%>">
                                                                                        <label class="template-shield-mdl-textfield__label" for="project-date-from<%=i%>">From</label>
                                                                                        <span class="template-shield-mdl-textfield__error">Input is not a number!</span>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="col-sm-5">
                                                                                    <div class="template-shield-mdl-textfield template-shield-mdl-js-textfield template-shield-mdl-textfield--floating-label">
                                                                                        <input class="template-shield-mdl-textfield__input year project-date-to-content" type="text" pattern="-?[0-9]*(\.[0-9]+)?" placeholder="yyyy" id="project-date-to<%=i%>">
                                                                                        <label class="template-shield-mdl-textfield__label" for="project-date-to<%=i%>">To</label>
                                                                                        <span class="template-shield-mdl-textfield__error">Input is not a number!</span>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-sm-12">
                                                                            <div class="template-shield-mdl-textfield template-shield-mdl-js-textfield template-shield-mdl-textfield--floating-label full-width">
