        <script type="text/javascript">

            // For region dropdown
            $(document).ready(function() {

				// Check the validity state and update field accordingly.
				// document.querySelectorAll("input[required]").forEach(function (e) {
			    //    e.required = true;
			    // });

                $('#creativeRegion').select2({
                    data: ['', 'Barrie', 'Bay of Quinte', 'Bow Valley', 'Calgary', 'Charlottetown', 'Comox Valley',
                        'Durham Region', 'Edmonton', 'Fredericton', 'Halifax', 'Hamilton', 'Kamloops', 'Kingston', 'Montreal',
                        'Nanaimo', 'Nelson', 'Niagara Falls', 'Ottawa', 'Ottawa Valley', 'Peel Region', 'Peterborough',
                        'Prince George', 'Revelstoke', 'Sarnia Lambton', 'Saskatoon', 'Sault Ste Marie', 'Smithers', 'Toronto',
                        'Vancouver', 'Waterloo', 'Whitehorse', 'Windsor', 'Winnipeg', 'York Region'],
                    placeholder: function () {
                        $(this).data('placeholder');
                    }
                });

                $(".skill-range-slider").each(function() {
                    $(this).ionRangeSlider({
                        min: 10,
                        max: 100,
                        from: $(this).val()
                    })
                });

				$('.service-iconpicker')
					.iconpicker()
					.on('change', function(e) {
						if (e.icon == 'empty') {
							$(e.delegateTarget).siblings('.mdl-textfield__error').css('visibility', 'visible');
							//$(e).addClass('is-invalid');
						} else {
							$(e.delegateTarget).siblings('.mdl-textfield__error').css('visibility', 'hidden');
							//$(e).removeClass('is-invalid');
						}
					});

                // $('.icp-auto').iconpicker();

                $('.portfolio-container').pajinate({
                    items_per_page : 3,
                    item_container_id : '#portfolio',
                    nav_panel_id : '.pagination-container ul',
                    show_first_last: false
                });

                //enableHover();
            });

            $('.hover-component').on('mouseenter', function() {
                $(this).addClass('add-box-shadow');
            });

            $('.hover-component').on('mouseleave', function() {
                $(this).removeClass('add-box-shadow');
            });

            $('.add-button').on('click', function() {
                var supportingText = $(this).parents('.mdl-card__supporting-text');
                var content = $(supportingText).find('.add-button-content');
                var showButton = $(supportingText).find('.show-content-button');
                $(content).removeClass('hide-content');
                $(this).parents('.show-content-button').addClass('hide-content');
                //$(showButton).addClass('hide-content');
            });

            // $('.edit-content').on('click', function() {
            //     var mainContent = $(this).parents('.main-content');
            //     var editableContent = $(mainContent).siblings('.editable-content');
            //     $(mainContent).addClass('hide-content');
            //     $(editableContent).removeClass('hide-content');
            //     //$(this).parents('.hover-component').off("mouseleave mouseenter");
            //     $(this).parents('.hover-component').addClass('add-box-shadow');
            // });

            $('.cancel-content').on('click', function() {
                $(this).parents('.add-button-content').addClass('hide-content');
                $(this).parents('.add-button-content').siblings('.show-content-button').removeClass('hide-content');
            })


            $('.update-skill-button, .cancel-skill-button').on('click', function() {
                var editableContent = $(this).parents('.editable-content');
                var mainContent = $(editableContent).siblings('.main-content');
                $(editableContent).addClass('hide-content');
                $(mainContent).removeClass('hide-content');
                $(this).parents('.hover-component').removeClass('add-box-shadow');
                //enableHover();
            });

            //For mm/yy component
            // $('dialog .input-date-group .mnth').datepicker({
            //     autoclose: true,
            //     minViewMode: 1,
            //     format: "mm/yyyy"
            // });
			//
            // $('dialog .input-date-group .year').datepicker({
            //     autoclose: true,
            //     viewMode: "years",
            //     minViewMode: "years",
            //     format: "yyyy",
            //     orientation: "auto"
            // });

			$("#add-a-project, #edit-a-project, #add-a-edu, #edit-a-edu, #add-a-learning, #edit-a-learning")
				.delegate(".input-daterange input", "focusin", function(e){

					var options = {
						viewMode: "years",
						format: "yyyy",
						minViewMode: "years",
						container: e.delegateTarget,
						startDate: '1900',
						endDate: '+0y'
					};

					//var inputs = $(e.delegateTarget).find('.input-daterange input'); //Should only be 2

					var from = $(e.delegateTarget).find('.input-daterange .from')[0];
					var to = $(e.delegateTarget).find('.input-daterange .to')[0];

					$(from).datepicker(options).on('changeDate', function(e){
				    	$(to).datepicker("setStartDate", e.date.getFullYear().toString());
				  	});
				  	$(to).datepicker(options).on('changeDate', function(e){
				    	$(from).datepicker("setEndDate", e.date.getFullYear().toString());
				  	});

					//datepickerParams(options, $(from), $(to));
				});

			function datepickerParams(options, dateFrom, dateTo) {
				//var dateFrom = $('#' + dateFromId);
				//var dateTo = $('#' + dateToId);

				dateFrom.datepicker(options).on('changeDate', function(e){
			    	dateTo.datepicker("setStartDate", e.date.getFullYear().toString());
			  	});
			  	dateTo.datepicker(options).on('changeDate', function(e){
			    	dateFrom.datepicker("setEndDate", e.date.getFullYear().toString());
			  	});
			}

            // $('.icp').on('iconpickerSelect', function(e) {
            //     //console.log(e.iconpickerValue);
            //     var iconSelected = $(e.iconpickerItem[0]).find('i').attr('class');
            //     $(this).attr('data-selected', iconSelected.split(' ')[1]);
            // });

			$('.service-iconpicker').on('change', function(e) {
				$(this).attr('data-selected', e.icon);
			});

            function autoresize(textarea) {
                textarea.style.height = '0px';     //Reset height, so that it not only grows but also shrinks
                textarea.style.height = (textarea.scrollHeight+10) + 'px';    //Set new height
            }

            $('.autosize').keyup(function () {
                autoresize(this);
            });

        </script>

		<script>

			//Register all dialogs to polyfill
			var dialogAll = document.querySelectorAll('dialog');
			$(dialogAll).each(function() {
				var dialog = this;
				if (!dialog.show) {
					dialogPolyfill.registerDialog(dialog);
				}
				dialog.querySelector('.close').addEventListener('click', function() {
					dialog.close();
					removeRequired(dialog);
