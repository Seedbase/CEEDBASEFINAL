<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="">
        <meta name="author" content="CSSLoss.com">
        <link rel="icon" href="img/favicon.ico">
        <title>CeedBase</title>

        <!-- BOOTSTRAP CORE CSS -->
        <link rel="stylesheet" href="css/vendor/bootstrap.min.css">

        <!-- Styles for Canvas Template -->
        <link rel="stylesheet" href="css/style-updated.css" type="text/css" />
        <link rel="stylesheet" href="css/dark.css" type="text/css" />
        <link rel="stylesheet" href="css/swiper.css" type="text/css" />
        <link rel="stylesheet" href="css/font-icons.css" type="text/css" />
        <link rel="stylesheet" href="css/animate.css" type="text/css" />
        <link rel="stylesheet" href="css/responsive.css" type="text/css" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Canvas Components CSS -->
        <%# <link rel="stylesheet" href="css/canvas-components/datepicker.css" type="text/css" />%>
		<link rel="stylesheet" href="css/bootstrap-datepicker.min.css" type="text/css" />
        <link rel="stylesheet" href="css/canvas-components/radio-checkbox.css" type="text/css" />
        <link rel="stylesheet" href="css/canvas-components/ion.rangeslider.css" type="text/css" />
        <link rel="stylesheet" href="css/canvas-components/bs-filestyle.css" type="text/css" />

        <!-- Google Material Design Lite CSS -->
        <link rel="stylesheet" href="css/mdl/material.min.css" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

        <link href="plugins/select2/dist/css/select2.min.css" rel="stylesheet"/>
        <link rel="stylesheet" href="css/font-awesome.min.css"/>
        <%# <link rel="stylesheet" href="css/fontawesome-iconpicker.min.css"/>%>
		<link rel="stylesheet" href="css/bootstrap-iconpicker.min.css"/>

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.theme.min.css">
        <link rel="stylesheet" type="text/css" media="screen" href="http://ajax.googleapis.com/ajax/libs/jqueryui/1.7.2/themes/base/jquery-ui.css">
        <link href="plugins/fine-uploader/fine-uploader/fine-uploader-gallery.min.css" rel="stylesheet">
        <link href="plugins/fine-uploader/fine-uploader/fine-uploader.min.css" rel="stylesheet">

		<link href="css/crest-admin-1.0/style.css" rel="stylesheet" />
		<link href="css/crest-admin-1.0/perfect-scrollbar.min.css" rel="stylesheet" />

        <!-- Custom CSS -->
        <link rel="stylesheet" href="css/profile.css" />

    </head>

    <body class="stretched">
        <!-- LOADER -->
        <div class="loader-wrapper">
            <div class="loader"></div>
        </div>

        <div style="display: none">
            <%if (user.provider == 'google') { %>
            <input id="providerId" type="text" value="<%= user.google.id %>">
            <% } %>
            <%if (user.provider == 'facebook') { %>
            <input id="providerId" type="text" value="<%= user.facebook.id %>">
            <% } %>
            <%if (user.provider == 'linkedin') { %>
            <input id="providerId" type="text" value="<%= user.linkedIn.id %>">
            <% } %>
            <%if (user.provider == 'twitter') { %>
            <input id="providerId" type="text" value="<%= user.twitter.id %>">
            <% } %>

            <p id="videoResume"></p>

            <p id="userProfileObject"> <%= JSON.stringify(user) %> </p>
        </div>

		<div id="side-panel" style="top: 60px;">
				<div class="side-panel-wrap">
					<h6>Manage this user account</h6>
					<form>
						<div class="row">
							<div class="col-sm-12">
								<div class="mdl-textfield mdl-js-textfield full-width mdl-textfield--floating-label">
									<input class="mdl-textfield__input" type="email" id="changeEmail1" value="">
									<label class="mdl-textfield__label" for="changeEmail1">New email</label>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-sm-12">
								<div class="mdl-textfield mdl-js-textfield full-width mdl-textfield--floating-label">
									<input class="mdl-textfield__input" type="email" id="changeEmail2" value="">
									<label class="mdl-textfield__label" for="changeEmail2">Re-enter email</label>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-sm-12">
								<div class="mdl-textfield mdl-js-textfield full-width mdl-textfield--floating-label">
									<input class="mdl-textfield__input" type="password" id="changePassword1" value="">
									<label class="mdl-textfield__label" for="changePassword1">New password</label>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-sm-12">
								<div class="mdl-textfield mdl-js-textfield full-width mdl-textfield--floating-label">
									<input class="mdl-textfield__input" type="password" id="changePassword2" value="">
									<label class="mdl-textfield__label" for="changePassword2">Re-enter password</label>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-sm-12">
								<button class="mdl-button mdl-js-button" type="submit">
								  Save Changes
								</button>
								<button class="mdl-button mdl-js-button">
								  Cancel
								</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>

		<div class='page-topbar'>
			<div class="logo-area"></div>
            <div class='quick-area'>
                <div class='pull-right'>
                    <ul class="info-menu right-links list-inline list-unstyled">
                        <li class="notify-toggle-wrapper">
                            <a href="#" id="notificationLink" data-toggle="dropdown" class="toggle" style="margin: 0px;">
                                <i class="fa fa-bell"></i>
                                <span class="badge badge-accent messageCounter">3</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-right notifications animated fadeIn">
                                <li class="total">
                                    <span class="small">
                                        You have <strong class="messageCounter">3</strong> new messages.
                                    </span>
                                </li>
                                <li class="list">
									<ul class="dropdown-menu-list list-unstyled ps-scrollbar" id="messageUl">
										<li id="messageTemplate" class="hide-content">
											<div>
												<span class="name">
													<strong id="messageName"></strong>
													<%# <span class="time small" id="messageTime"></span>%>
												</span>
												<span class="desc small" id="messageDesc">
												</span>
											</div>
										</li>
										<li>
											<div>
												<span class="name">
													<strong>Clarine Vassar</strong>
													<%# <span class="time small">- 15 mins ago</span>%>
												</span>
												<span class="desc small">
													Sometimes it takes a lifetime to win a battle.
												</span>
											</div>
										</li>
										<li>
											<div>
												<span class="name">
													<strong>Brooks Latshaw</strong>
													<%# <span class="time small">- 45 mins ago</span>%>
												</span>
												<span class="desc small">
													Sometimes it takes a lifetime to win a battle.
												</span>
											</div>
										</li>
										<li>
											<div>
												<span class="name">
													<strong>Clementina Brodeur</strong>
													<%# <span class="time small">- 1 hour ago</span>%>
												</span>
												<span class="desc small">
													Sometimes it takes a lifetime to win a battle.
												</span>
											</div>
										</li>
									</ul>
                                </li>

                                <%# <li class="external">
                                    <a href="javascript:;">
                                        <span>Read All Messages</span>
                                    </a>
                                </li>%>
                            </ul>
                        </li>
						<li class="">
							<div id="side-panel-trigger" class="side-panel-trigger" style="margin: 0px; right: 0px; position: relative;">
								<a href="#">
									<i class="fa fa-cog" style="color: #fff;"></i>
								</a>
							</div>
						</li>
                    </ul>
                </div>
            </div>
        </div>

        <div id="wrapper" class="clearfix">
            <section id="intro" class="clearfix section notopborder nomargin">
                <div class="container input-date-group">
                    <div class="row">
                        <div id="intro-img" class="col-md-3">
							<%if (user.isUserProfileAuthenticated) { %>
							<span class="badge badge-accent" id="profile-badge">
								<img src="/images/partners/verify-shield.png">
							</span>
							<div class="mdl-tooltip" data-mdl-for="profile-badge">
								Profiled Verified by <%= user.userProfileAuthenticatedBy %>
							</div>
							<% } %>
                            <div class="img-container">
                                <img src="<%= user.image %>" class="center" alt="Avatar">
                            </div>
                        </div>
                        <div id="intro-profile" class="col-md-9">
                            <div class="row form-horizontal">
                                <div class="col-sm-6"><h4 class="custom-heading">Hello, I'm</h4></div>
                                <div class="col-sm-12">
                                    <div class="mdl-textfield mdl-js-textfield full-width profile-name">
                                        <input class="mdl-textfield__input" type="text" id="introText1" value="<%= user.displayName %>" pattern="^[a-zA-Z][a-zA-Z0-9-_\.\s]{1,30}$">
                                        <label class="mdl-textfield__label" for="introText1">Full Name</label>
										<span class="mdl-textfield__error">Input can only contain digits, letters and spaces!</span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-5-custom">
                                    <div class="mdl-textfield mdl-js-textfield full-width">
										<% if (user.profile && user.profile.introText) { %>
                                        	<input class="mdl-textfield__input" type="text" id="introText2" value="<%=user.profile.introText[2]%>" pattern="^[a-zA-Z][a-zA-Z0-9-_\.\s]{1,20}$">
										<% } else { %>
											<input class="mdl-textfield__input" type="text" id="introText2" value="" pattern="^[a-zA-Z][a-zA-Z0-9-_\.\s]{1,20}$">
										<% } %>
                                        <label class="mdl-textfield__label" for="introText2">Developer</label>
										<span class="mdl-textfield__error">Input can only contain digits, letters and spaces!</span>
                                    </div>
                                </div>
                                <div class="col-sm-1" style="text-align: center; padding-top: 4px;">and</div>
                                <div class="col-sm-5-custom">
                                    <div class="mdl-textfield mdl-js-textfield full-width">
										<% if (user.profile && user.profile.introText) { %>
                                        	<input class="mdl-textfield__input" type="text" id="introText3" value="<%=user.profile.introText[3]%>" pattern="^[a-zA-Z][a-zA-Z0-9-_\.\s]{1,20}$">
										<% } else { %>
											<input class="mdl-textfield__input" type="text" id="introText3" value="" pattern="^[a-zA-Z][a-zA-Z0-9-_\.\s]{1,20}$">
										<% } %>
                                        <label class="mdl-textfield__label" for="introText3">Designer</label>
										<span class="mdl-textfield__error">Input can only contain digits, letters and spaces!</span>
                                    </div>
                                </div>
                            </div>

                            <div class="row topmargin-sm">
                                <div class="col-sm-12">
                                    <label>Opportunities I&#39;m seeking</label>
                                    <div class="row">
                                        <div class="col-lg-3 col-md-6 col-sm-6">
                                            <input id="unPaidInternship" class="radio-style" name="opportunityOption" type="radio" value="unPaidInternship">
                                            <label for="unPaidInternship" class="radio-style-3-label radio-small radio-button-label">Unpaid Internship</label>
                                        </div>
                                        <div class="col-lg-3 col-md-6 col-sm-6">
                                            <input id="paidInternship" class="radio-style" name="opportunityOption" type="radio" value="paidInternship">
                                            <label for="paidInternship" class="radio-style-3-label radio-small radio-button-label">Paid internship</label>
                                        </div>
                                        <div class="col-lg-3 col-md-6 col-sm-6">
                                            <input id="tempContract" class="radio-style" name="opportunityOption" type="radio" value="tempContract">
                                            <label for="tempContract" class="radio-style-3-label radio-small radio-button-label">Temporary Contract</label>
                                        </div>
                                        <div class="col-lg-3 col-md-6 col-sm-6">
                                            <input id="fullTimeHire" class="radio-style" name="opportunityOption" type="radio" value="fullTimeHire">
                                            <label for="fullTimeHire" class="radio-style-3-label radio-small radio-button-label">Full Time Hire</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <div id="content" style="background-color: #F9F9F9;">
                <div id="content-wrap">
                    <div class="container-fluid clearfix" style="margin: 40px auto; padding: 0 20px;">
                        <div class="row card-block">
                            <div class="col-sm-12 col-md-8 col-md-offset-2">
                                <div class="demo-card-wide mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">About Me</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text input-date-group">
                                        <div class="row">
											<div class="col-sm-12">
                                                <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label" style="width: 90%;">
                                                    <textarea class="mdl-textfield__input autoresize" type="text" rows="4" id="passion" maxlength="200" style="overflow: hidden; max-width:100%;" ><%= user.profile ? user.profile.passion : '' %></textarea>
                                                    <label class="mdl-textfield__label" for="passion">Describe your passion</label>
													<span class="mdl-textfield__error">Input must be defined!</span>
                                                </div>
                                            </div>
										</div>
										<div class="row">
											<div class="col-sm-4">
												<label class="custom-mdl-textfield__label" for="creativeRegion" style="">Region</label>
												<select id="creativeRegion" class="form-control select2-element" data-placeholder="Select a region">
												</select>
											</div>
										</div>
										<div class="row topmargin-sm">
			                                <div class="col-sm-12">
			                                    <label>Video Resume</label>
			                                    <div id="profile-video-uploader"></div>
			                                </div>
			                            </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row card-block">
                            <div class="col-sm-12 col-md-8 col-md-offset-2">
                                <div class="mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">Skills</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text input-date-group">

                                        <!-- Skill Template -->
                                        <div class="skill-item col-sm-6 hover-component hide-content" id="skill-template">
                                            <div class="main-content">
                                                <div class="row">
                                                    <div class="col-sm-10">
                                                        <span id="skill-title" class="skill-title"></span>
                                                        <li data-percent="">
                                                            <div class="progress nopadding">
                                                                <div class="progress-percent">
                                                                    <div class="counter counter-inherit">
                                                                        <span id="skill-range" class="skill-range" data-from="0" data-to="" data-refresh-interval="30" data-speed="1100"></span>%
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </li>
                                                    </div>
                                                    <div class="col-sm-2">
                                                        <a class="edit-skill-button edit"><i class="fa fa-pencil fa-lg" aria-hidden="true"></i></a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <ul class="skills row nopadding">
                                            <!-- Existing skills -->
                                            <% if (user.profile && user.profile.skills ) { %>
                                                <% for (var i = 1; i <= user.profile.skills.length; i++) {%>
                                                    <div class="skill-item col-sm-6 hover-component" id="skill<%=i%>">
                                                        <div class="main-content">
                                                            <div class="row">
                                                                <div class="col-sm-10">
																	<% if (user.profile.skills[i].verifiedCount > 0) { %>
                                                                    	<span id="skill-title" class="mdl-badge skill-title" data-badge="<%=user.profile.skills[i].verifiedCount%>">
																	<% } else { %>
																		<span id="skill-title" class="skill-title" data-badge="">
																	<% } %>
																			<%=user.profile.skills[i].skill%>
																		</span>
                                                                    <li data-percent="<%=user.profile.skills[i].rating%>">
                                                                        <div class="progress nopadding">
                                                                            <div class="progress-percent">
                                                                                <div class="counter counter-inherit">
                                                                                    <span id="skill-range" class="skill-range" data-from="0" data-to="<%=user.profile.skills[i].rating%>" data-refresh-interval="30" data-speed="1100"></span>%
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </li>
                                                                </div>
                                                                <div class="col-sm-2">
                                                                    <a class="edit edit-skill-button"><i class="fa fa-pencil fa-lg" aria-hidden="true"></i></a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            <% } %>
                                        </ul>
                                    </div>
									<div class="mdl-card__menu">
								    	<button id="add-a-new-skill-button" class="mdl-button mdl-button--icon mdl-js-button mdl-js-ripple-effect">
								      		<i class="material-icons">add</i>
									    </button>
								  	</div>
                                </div>
                            </div>
                        </div>

                        <div class="row card-block">
							<div class="col-sm-12 col-md-8 col-md-offset-2">
                                <div class="mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">Projects</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text">
                                        <div class="row">
                                            <div class="col-sm-12 col-md-8 col-md-offset-2">
                                                <!-- Project Template -->
                                                <div class="project-item timeline-item hover-component hide-content" id="project-template">
                                                    <div class="main-content">
                                                        <span class="material-icons" data-badge=""><h4 class="item-title"></h4></span>
                                                        <div class="item-edit">
                                                            <a class="edit-project-button edit"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                                                        </div>
                                                        <span class="item-period"></span>
                                                        <p class="item-description"></p>
                                                    </div>
                                                </div>

                                                <div id="project-timeline" class="timeline">
                                                    <% if (user.profile && user.profile.experiences) {%>
                                                        <% for (var i = 1; i <= user.profile.experiences.length; i++) {%>
                                                            <div class="project-item timeline-item" id="project<%=i%>">
                                                                <div class="main-content">
																	<% if (user.profile.experiences[i].verifiedCount > 0) { %>
																	<span class="material-icons mdl-badge" data-badge="<%=user.profile.experiences[i].verifiedCount%>">
																	<% } else { %>
																	<span class="" data-badge="">
																	<% } %>
																		<h4 class="item-title"><%= user.profile.experiences[i].title%></h4>
																	</span>
																	<div class="item-edit">
                                                                        <a class="edit-project-button edit"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                                                                    </div>
                                                                    <div class="item-edit">
                                                                        <a><i class="fa fa-pencil" aria-hidden="true"></i></a>
                                                                        <a><i class="fa fa-remove" aria-hidden="true"></i></a>
                                                                    </div>
                                                                    <span class="item-period"><%= user.profile.experiences[i].from %> - <%= user.profile.experiences[i].to %></span>
                                                                    <p class="item-description"><%= user.profile.experiences[i].description %></p>
                                                                </div>
                                                            </div>
                                                        <% } %>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
									<div class="mdl-card__menu">
								    	<button id="add-a-new-project-button" class="mdl-button mdl-button--icon mdl-js-button mdl-js-ripple-effect">
								      		<i class="material-icons">add</i>
									    </button>
								  	</div>
                                </div>
                            </div>
                        </div>

						<div class="row">
							<div class="col-sm-6 col-md-4 col-md-offset-2">
								<div class="card-block">
									<div class="mdl-card mdl-shadow--2dp">
	                                    <div class="mdl-card__title">
	                                        <h2 class="mdl-card__title-text">Learning</h2>
	                                    </div>
										<div class="mdl-card__supporting-text">
	                                        <div class="row">
	                                            <div class="col-sm-12">
	                                                <!-- Learning Template -->
	                                                <div class="learning-item timeline-item hover-component hide-content" id="learning-template">
	                                                    <div class="main-content">
	                                                        <span class="material-icons" data-badge=""><h4 class="item-title"></h4></span>
	                                                        <div class="item-edit">
	                                                            <a class="edit-learning-button edit"><i class="fa fa-pencil" aria-hidden="true"></i></a>
	                                                        </div>
	                                                        <span class="item-period"></span>
	                                                        <p class="item-description"></p>
	                                                    </div>
	                                                </div>

	                                                <div id="learning-timeline" class="timeline">
	                                                    <% if (user.profile && user.profile.externalLinks) {%>
	                                                        <% for (var i = 1; i <= user.profile.externalLinks.length; i++) {%>
	                                                            <div class="project-item timeline-item" id="project<%=i%>">
	                                                                <div class="main-content">
																		<% if (user.profile.externalLinks[i].verifiedCount > 0) { %>
																		<span class="material-icons mdl-badge" data-badge="<%=user.profile.externalLinks[i].verifiedCount%>">
																		<% } else { %>
																		<span class="" data-badge="">
																		<% } %>
																			<h4 class="item-title"><%= user.profile.externalLinks[i].title%></h4>
																		</span>
																		<div class="item-edit">
	                                                                        <a class="edit-learning-button edit"><i class="fa fa-pencil" aria-hidden="true"></i></a>
	                                                                    </div>
	                                                                    <div class="item-edit">
	                                                                        <a><i class="fa fa-pencil" aria-hidden="true"></i></a>
	                                                                        <a><i class="fa fa-remove" aria-hidden="true"></i></a>
	                                                                    </div>
	                                                                    <span class="item-period"><%= user.profile.externalLinks[i].from %> - <%= user.profile.externalLinks[i].to %></span>
	                                                                    <p class="item-description"><%= user.profile.externalLinks[i].description %></p>
	                                                                </div>
	                                                            </div>
	                                                        <% } %>
	                                                    <% } %>
	                                                </div>
	                                            </div>
	                                        </div>
	                                    </div>
