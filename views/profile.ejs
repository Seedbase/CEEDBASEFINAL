			$("#add-a-project, #edit-a-project, #add-a-edu, #edit-a-edu, #add-a-learning, #edit-a-learning")
				.delegate(".input-daterange input", "focusin", function(e){

					var options = {
						viewMode: "years",
						format: "yyyy",
						minViewMode: "years",
						container: e.delegateTarget,
						startDate: '1900',
						endDate: '+0y'
					};

					//var inputs = $(e.delegateTarget).find('.input-daterange input'); //Should only be 2

					var from = $(e.delegateTarget).find('.input-daterange .from')[0];
					var to = $(e.delegateTarget).find('.input-daterange .to')[0];

					$(from).datepicker(options).on('changeDate', function(e){
				    	$(to).datepicker("setStartDate", e.date.getFullYear().toString());
				  	});
				  	$(to).datepicker(options).on('changeDate', function(e){
				    	$(from).datepicker("setEndDate", e.date.getFullYear().toString());
				  	});

					//datepickerParams(options, $(from), $(to));
				});

			function datepickerParams(options, dateFrom, dateTo) {
				//var dateFrom = $('#' + dateFromId);
				//var dateTo = $('#' + dateToId);

				dateFrom.datepicker(options).on('changeDate', function(e){
			    	dateTo.datepicker("setStartDate", e.date.getFullYear().toString());
			  	});
			  	dateTo.datepicker(options).on('changeDate', function(e){
			    	dateFrom.datepicker("setEndDate", e.date.getFullYear().toString());
			  	});
			}

