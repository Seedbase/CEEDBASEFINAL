<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="shortcut icon" href="img/favicon.png">
    <title>CeedBase</title>
    <link rel="stylesheet" type="text/css" href="css/form_style.css"/>
    <link rel="stylesheet" type="text/css" href="css/perfect-scrollbar.min.css"/>
    <link rel="stylesheet" type="text/css" href="css/wizard.css"/>
    <link rel="stylesheet" type="text/css" href="css/select2.min.css"/>
    <link rel="stylesheet" type="text/css" href="css/form_bootstrap-slider.min.css"/>
    <link href="plugins/fine-uploader/fine-uploader/fine-uploader-gallery.min.css" rel="stylesheet">
        <link href="plugins/fine-uploader/fine-uploader/fine-uploader.min.css" rel="stylesheet">
    <link rel="stylesheet" type="text/css"
          href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css"/>
    <link rel="stylesheet" href="css/app.css" type="text/css"/>
</head>
<body>
    <div class="container">
        <div class="navbar-header">
            <a class="navbar-brand" href="/"><img src="images/ceedbaseLogo/ceedbase.png" width="100"/></a>
        </div>
    </div>
    <div style="display: none">
        <p id="jobUploaduploadFileOne"></p>
        <p id="jobUploaduploadFileTwo"></p>
        <p id="jobUploaduploadFileThree"></p>
        <p id="jobUploaduploadFileFour"></p>
        <p id="jobUploaduploadFileFive"></p>
    </div>
<!-- Client Form Structure-->
<div class="main-content container" style="overflow-x:hidden; padding: 0">
    <div class="row wizard-row">
        <div class="col-md-12 fuelux">
            <div class="block-wizard">
                <div id="wizard1" class="wizard wizard-ux">
                    <div class="steps-container">
                        <ul class="steps">
                            <li data-step="1" class="active">Step 1<span class="chevron"></span></li>
                            <li data-step="2">Step 2<span class="chevron"></span></li>
                            <li data-step="3">Step 3<span class="chevron"></span></li>
                        </ul>
                    </div>
                    <div class="actions">
                        <button type="button" class="btn btn-xs btn-prev btn-secondary"><i
                                    class="fa fa-chevron-left"></i>Prev
                        </button>
                        <button type="button" data-last="Finish" class="btn btn-xs btn-next btn-secondary">Next<i
                                    class="fa fa-chevron-right"></i></button>
                    </div>
                    <div class="step-content">
                        <div data-step="1" class="step-pane active" id="step-one">
                            <div class="container">
                                <form action="#" data-parsley-namespace="data-parsley-" data-parsley-validate=""
                                      novalidate="" class="form-horizontal group-border-dashed">
                                    <div class="form-group row">
                                        <div class="offset-sm-3 col-sm-12">
                                            <h3 class="wizard-title">Basic Information</h3>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label class="col-sm-3 col-form-label">Your Company Name</label>
                                        <div class="col-sm-6">
                                            <input type="text" placeholder="Company Name" class="form-control" id="clientCompanyName">
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label class="col-sm-3 col-form-label">E-Mail</label>
                                        <div class="col-sm-6">
                                            <input type="text" placeholder="E-Mail" class="form-control" id="clientEmail">
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label class="col-sm-3 col-form-label">Phone Number</label>
                                        <div class="col-sm-6">
                                            <input type="text" placeholder="Phone Number" class="form-control" id="clientPhone">
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label class="col-sm-3 col-form-label">Email Notifications</label>
                                        <div class="col-sm-6">
                                            <p>By choosing yes, you prefer we reach you by email. Otherwise we will
                                                communicate with you by the cell phone provided.</p>
                                        </div>
                                        <div class="col-sm-3 xs-pt-15">
                                            <div class="switch-button">
                                                <input type="checkbox" checked="" name="swt2" id="swt2"><span>
                                                <label for="swt2"></label></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <label class="col-sm-3 col-form-label">How Did You Hear About Us</label>
                                        <div class="col-sm-6">
                                            <select class="form-control custom-select">
                                                <option value="1" selected id="howDidClientHearOptionOne">Website</option>
                                                <option value="2" id="howDidClientHearOptionTwo">Social Media</option>
                                                <option value="3" id="howDidClientHearOptionThree">Word of Mouth</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="form-group row pt-3">
                                        <div class="col-sm-12 text-center">
                                            <button class="btn btn-secondary btn-space">Cancel</button>
                                            <button data-wizard="#wizard1"
                                                    class="btn btn-primary btn-space wizard-next" id="next-step-one">Next Step
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div data-step="2" class="step-pane">
                            <form action="#" data-parsley-namespace="data-parsley-" data-parsley-validate=""
                                  novalidate="" class="group-border-dashed">
                                <div class="form-group row">
                                    <div class="col-sm-7">
                                        <h3 class="wizard-title">Job Information</h3>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label text-right">Job Title</label>
                                    <div class="col-sm-6">
                                        <input type="text" placeholder="User Title" class="form-control" id="clientJobTitle">
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label text-right">Job Type</label>
                                    <div class="col-sm-6 mt-2">
                                        <div class="row">
                                            <div class="col-sm-6 mt-2">                              
                                                <label class="custom-control custom-radio">
                                                    <input type="radio" name="radio-color" checked="" class="custom-control-input" id="clientJobTypeOptionOne">
                                                        <span class="custom-control-indicator custom-control-color"></span>
                                                        <span class="custom-control-description">Unpaid Internship</span>
                                                </label>
                                            </div>
                                            <div class="col-sm-6 mt-2">
                                                <label class="custom-control custom-radio">
                                                    <input type="radio" name="radio-color" class="custom-control-input" id="clientJobTypeOptionTwo">
                                                        <span class="custom-control-indicator custom-control-color"></span>
                                                        <span class="custom-control-description">Paid Internship</span>
                                                </label>
                                            </div>
                                            <div class="col-sm-6 mt-2">
                                                <label class="custom-control custom-radio">
                                                    <input type="radio" name="radio-color" class="custom-control-input" id="clientJobTypeOptionThree"><span
                                                            class="custom-control-indicator custom-control-color"></span><span
                                                            class="custom-control-description">Temporary Contract</span>
                                                </label>
                                            </div>
                                            <div class="col-sm-6 mt-2">
                                                <label class="custom-control custom-radio">
                                                    <input type="radio" name="radio-color" class="custom-control-input" id="clientJobTypeOptionFour"><span
                                                            class="custom-control-indicator custom-control-color"></span><span
                                                            class="custom-control-description">Full Time Hire</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label text-right">Job Location</label>
                                    <div class="col-sm-6">
                                        <input type="text" placeholder="e.g Ottawa, ON" class="form-control" id="clientJobLocation">
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label class="col-sm-3 col-form-label text-right">What is your rate of pay?</label>
                                    <div class="col-sm-3">
                                        <input id="clientJobRateOfPay" type="Rate" required="" placeholder="$" class="form-control">
                                    </div>
                                    <div class="col-sm-3">
                                        <select class="form-control custom-select">
                                            <option value="1" selected id="clientJobRateOfPayTypeOptionOne">per hour</option>
                                            <option value="2" id="clientJobRateOfPayTypeOptionTwo">per day</option>
                                            <option value="3" id="clientJobRateOfPayTypeOptionThree">per month</option>
                                            <option value="3" id="clientJobRateOfPayTypeOptionFour">per year</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label class="col-3 col-form-label text-right">Job description</label>
                                    <div class="col-6">
                                        <textarea class="form-control" id="clientJobDescription"></textarea>
                                    </div>
                                </div>
                                <div class="form-group row pt-3">
                                    <div class="col-sm-12 text-center">
                                        <button data-wizard="#wizard1"
                                                class="btn btn-secondary btn-space wizard-previous">Previous
                                        </button>
                                        <button data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next" id="next-step-two">
                                            Next Step
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div data-step="3" class="step-pane">
                            <form action="#" data-parsley-namespace="data-parsley-" data-parsley-validate=""
                                  novalidate="" class="form-horizontal group-border-dashed">
                                <div class="form-group row">
                                    <div class="col-sm-7 text-center">
                                        <h3 class="wizard-title">Additional Information</h3>
                                    </div>
                                </div>
                                <div class="main-content container" style="padding: 0 !important">
                                    <form id="my-awesome-dropzone" action="" class="dropzone">
                                        <div id="client-job-uploader" style="width: 50%; margin-left: 18.5%" class="text-center">
                                             
                                        </div>
                                        <br>
                                        <p style="width: 50%; margin-left: 18.5%">Allowed files: pdf, doc, docx </p>
                                        <div style="padding: 20px"></div>
                                        <label class="custom-control custom-checkbox">
                                            <input type="checkbox" checked class="custom-control-input">
                                            <span class="custom-control-indicator"></span>
                                            <span class="custom-control-description">By clicking, you agree that this job will be posted and applications will be processed in accordance with CeedBase's Privacy Policy and Terms of Service. You consent to informing a user that you have opened, viewed or made a decision regarding the user's application</span>
                                        </label>
                                    </form>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-12 text-center">
                                        <button data-wizard="#wizard1"
                                                class="btn btn-secondary btn-space wizard-previous">Previous
                                        </button>
                                        <button data-wizard="#wizard1" class="btn btn-success btn-space wizard-next" id="next-step-complete">
                                            Complete
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
<script src="js/jquery.min.js" type="text/javascript"></script>
<script src="js/tether.min.js" type="text/javascript"></script>
<script src="js/perfect-scrollbar.jquery.min.js" type="text/javascript"></script>
<script src="js/bootstrap.min.js" type="text/javascript"></script>
<script src="js/app.js" type="text/javascript"></script>
<script src="js/wizard.js" type="text/javascript"></script>
<script src="js/select2.min.js" type="text/javascript"></script>
<script src="js/select2.full.min.js" type="text/javascript"></script>
<script src="js/bootstrap-slider.min.js" type="text/javascript"></script>
<script src="js/app-form-wizard.js" type="text/javascript"></script>
<script src="plugins/fine-uploader/fine-uploader/fine-uploader.min.js"></script>
<script src="js/client-form.js" type="text/javascript"></script>

<script type="text/javascript">
    $(document).ready(function () {
        //initialize the javascript
        App.init();
        App.wizard();
    });
</script>
<script type="text/template" id="qq-template">
            <div class="qq-uploader-selector qq-uploader qq-gallery" qq-drop-area-text="Drop files here" style="width: 100% !important">
                <div class="qq-total-progress-bar-container-selector qq-total-progress-bar-container">
                    <div role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" class="qq-total-progress-bar-selector qq-progress-bar qq-total-progress-bar"></div>
                </div>
                <div class="qq-upload-drop-area-selector qq-upload-drop-area" qq-hide-dropzone>
                    <span class="qq-upload-drop-area-text-selector"></span>
                </div>
                <div class="qq-upload-button-selector qq-upload-button btn-default" style="background-color: rgba(0, 0, 0, 0.04) !important; border:1px solid rgba(0, 0, 0, 0.04) !important" ng-click="initializeImageUploadErrorContent(false)">
                    <div style="color:#666">Upload</div>
                </div>
                <span class="qq-drop-processing-selector qq-drop-processing">
                    <span>Processing dropped files...</span>
                    <span class="qq-drop-processing-spinner-selector qq-drop-processing-spinner"></span>
                </span>
                <ul class="qq-upload-list-selector qq-upload-list" role="region" aria-live="polite" aria-relevant="additions removals">
                    <li style="max-width: 255px !important;">
                        <span role="status" class="qq-upload-status-text-selector qq-upload-status-text"></span>
                        <div class="qq-progress-bar-container-selector qq-progress-bar-container">
                            <div role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" class="qq-progress-bar-selector qq-progress-bar"></div>
                        </div>
                        <span class="qq-upload-spinner-selector qq-upload-spinner"></span>
                        <div class="qq-thumbnail-wrapper" style="width: 255px;">
                            <img class="qq-thumbnail-selector" qq-max-size="255" qq-server-scale>
                        </div>
                        <button type="button" class="qq-upload-cancel-selector qq-upload-cancel">X</button>
                        <button type="button" class="qq-upload-retry-selector qq-upload-retry">
                            <span class="qq-btn qq-retry-icon" aria-label="Retry"></span>
                            Retry
                        </button>

                        <div class="qq-file-info">
                            <div class="qq-file-name" style="color: #929292">
                                <span class="qq-upload-file-selector qq-upload-file"></span>
                                <span class="qq-edit-filename-icon-selector qq-btn qq-edit-filename-icon" aria-label="Edit filename"></span>
                            </div>
                            <input class="qq-edit-filename-selector qq-edit-filename" tabindex="0" type="text">
                            <span class="qq-upload-size-selector qq-upload-size"></span>
                            <button type="button" class="qq-btn qq-upload-delete-selector qq-upload-delete">
                                <span class="qq-btn qq-delete-icon" aria-label="Delete"></span>
                            </button>
                            <button type="button" class="qq-btn qq-upload-pause-selector qq-upload-pause">
                                <span class="qq-btn qq-pause-icon" aria-label="Pause"></span>
                            </button>
                            <button type="button" class="qq-btn qq-upload-continue-selector qq-upload-continue">
                                <span class="qq-btn qq-continue-icon" aria-label="Continue"></span>
                            </button>
                        </div>
                    </li>
                </ul>

                <dialog class="qq-alert-dialog-selector">
                    <div class="qq-dialog-message-selector"></div>
                    <div class="qq-dialog-buttons">
                        <button type="button" class="qq-cancel-button-selector">Close</button>
                    </div>
                </dialog>

                <dialog class="qq-confirm-dialog-selector">
                    <div class="qq-dialog-message-selector"></div>
                    <div class="qq-dialog-buttons">
                        <button type="button" class="qq-cancel-button-selector">No</button>
                        <button type="button" class="qq-ok-button-selector">Yes</button>
                    </div>
                </dialog>

                <dialog class="qq-prompt-dialog-selector">
                    <div class="qq-dialog-message-selector"></div>
                    <input type="text">
                    <div class="qq-dialog-buttons">
                        <button type="button" class="qq-cancel-button-selector">Cancel</button>
                        <button type="button" class="qq-ok-button-selector">Ok</button>
                    </div>
                </dialog>
            </div>
        </script>
        <script>
            var jobFileUploadCounter = 0;
            $(document).ready(function() {
                var videoUploader = new qq.FineUploader({
                    element: document.getElementById("client-job-uploader"),
                    template: 'qq-template',
                    debug: false,
                    multiple: true,
                    request: {
                        customHeaders: {},
                        endpoint: "/api/client/job/upload",
                        filenameParam: "qqfilename",
                        filenameParamName: 'file',
                        forceMultipart: true,
                        inputName: "clientJobFile",
                        method: "POST",
                        params: {},
                        paramsInBody: true,
                        totalFileSizeName: "qqtotalfilesize",
                        uuidName: "qquuid"
                    },
                    thumbnails: {
                        placeholders: {
                          notAvailablePath: "images/fineuploader/default-file-thumbnail.png"
                        }
                    },
                    validation: {
                        allowedExtensions: ['pdf', 'doc', 'docx'],
                        minSizeLimit: 0,
                        itemLimit: 5,
                        stopOnFirstInvalidFile: false
                    },
                    callbacks: {
                        onComplete: function(id, name, responseJSON, maybeXhr) {
                            var fileObject = {uuid: responseJSON.newUuid, size: responseJSON.size, name: responseJSON.name, url: responseJSON.url};
                            if (jobFileUploadCounter == 0) {
                                $('#jobUploaduploadFileOne').text(JSON.stringify(fileObject));
                                jobFileUploadCounter++;
                            } else if (jobFileUploadCounter == 1) {
                                $('#jobUploaduploadFileTwo').text(JSON.stringify(fileObject));
                                jobFileUploadCounter++;
                            } else if (jobFileUploadCounter == 2) {
                                $('#jobUploaduploadFileThree').text(JSON.stringify(fileObject));
                                jobFileUploadCounter++;
                            } else if (jobFileUploadCounter == 3) {
                                $('#jobUploaduploadFileFour').text(JSON.stringify(fileObject));
                                jobFileUploadCounter++;
                            } else {
                                $('#jobUploaduploadFileFive').text(JSON.stringify(fileObject));
                                jobFileUploadCounter++;
                            }
                        },
                        onError: function (id, name, reason, maybeXhrOrXdr) {
                            /*angular.element('#product-photo-uploader').scope().showImageUploadErrors(reason);*/
                        },
                        onSessionRequestComplete: function(response, success, xhrOrXdr) {
                            
                        }
                    }
                });
            });
        </script>
</body>
</html>