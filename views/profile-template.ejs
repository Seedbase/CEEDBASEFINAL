            <meta name="viewport" content="width=device-width, initial-scale=1" />

            <style>
                .side-panel-trigger-left {
                    float: left !important;
                }

                #panel-trigger { display: none; }

                .side-panel-left #panel-trigger {
                    display: block;
                    position: fixed;
                    cursor: pointer;
                    top: 20px;
                    left: 20px;
                    z-index: 399;
                    font-size: 16px;
                    width: 32px;
                    height: 32px;
                    line-height: 32px;
                    background-color: #FFF;
                    text-align: center;
                    border-radius: 2px;
                }

                .side-panel-open #panel-trigger { left: 320px; }

                .side-panel-left #panel-trigger i:nth-child(1),
                .side-panel-left.side-panel-open #panel-trigger i:nth-child(2) { display: block; }

                .side-panel-left.side-panel-open #panel-trigger i:nth-child(1),
                .side-panel-left #panel-trigger i:nth-child(2) { display: none; }

                .side-panel-open #panel-trigger {
                    -webkit-transition: left .4s ease;
                    -o-transition: left .4s ease;
                    transition: left .4s ease;
                }

                .side-panel-open #wrapper.docked {
                    left: 300px;
                    overflow-x: visible;
                }

                .primary-menu-left {
                    float: left!important;
                }
            </style>
        </head>

        <body class="stretched side-panel-left">

            <div class="body-overlay"></div>

            <div id="side-panel">

                <div id="side-panel-trigger-close" class="side-panel-trigger"><a href="#"><i class="icon-line-cross"></i></a></div>

