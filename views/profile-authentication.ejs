        <!-- Styles for Canvas Template -->
        <link rel="stylesheet" href="../css/style-updated.css" type="text/css" />
        <link rel="stylesheet" href="../css/dark.css" type="text/css" />
        <link rel="stylesheet" href="../css/swiper.css" type="text/css" />
        <link rel="stylesheet" href="../css/font-icons.css" type="text/css" />
        <link rel="stylesheet" href="../css/animate.css" type="text/css" />
        <link rel="stylesheet" href="../css/responsive.css" type="text/css" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Canvas Components CSS -->
        <link rel="stylesheet" href="../css/canvas-components/datepicker.css" type="text/css" />
        <link rel="stylesheet" href="../css/canvas-components/radio-checkbox.css" type="text/css" />
        <link rel="stylesheet" href="../css/canvas-components/ion.rangeslider.css" type="text/css" />
        <link rel="stylesheet" href="../css/canvas-components/bs-filestyle.css" type="text/css" />

        <!-- Google Material Design Lite CSS -->
        <link rel="stylesheet" href="../css/mdl/material.min.css" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">

        <link href="../plugins/select2/dist/css/select2.min.css" rel="stylesheet"/>
        <link rel="stylesheet" href="../css/font-awesome.min.css"/>
        <link rel="stylesheet" href="../css/fontawesome-iconpicker.min.css"/>

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.theme.min.css">
        <link rel="stylesheet" type="text/css" media="screen" href="http://ajax.googleapis.com/ajax/libs/jqueryui/1.7.2/themes/base/jquery-ui.css">
        <link href="../plugins/fine-uploader/fine-uploader/fine-uploader-gallery.min.css" rel="stylesheet">
        <link href="../../plugins/fine-uploader/fine-uploader/fine-uploader.min.css" rel="stylesheet">

        <!-- Custom CSS -->
        <link rel="stylesheet" href="../css/profile.css" />

    </head>

    <%# <div id="authenticate-whole-user-profile" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="background-color: #fff">
                <div class="modal-header">
                    <div class="col-lg-12">
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <h4 class="modal-title" style="color:#555">Provide your details</h4>
                    </div>
                </div>
                <div class="modal-body" style="color: #333">
                    <div style="margin-left: 15px">
                        <input class="form-control" id="wholeProfileAuthenticatorName" type="text" name="name" placeholder="name">
                        <input class="form-control" id="wholeProfileAuthenticatorEmail" type="email" name="email" placeholder="email">
                        <input class="form-control" id="wholeProfileAuthenticatorOrganisationName" type="text" name="organisation" placeholder="company or organisation name">
                        <button class="btn text-uppercase m-t-40" id="authenticateWholeProfile"><span>Authenticate</span></button>
                    </div>

                </div>

            </div>
        </div>
    </div>%>

    <body class="stretched">

        <!-- LOADER -->
        <div class="loader-wrapper">
            <div class="loader"></div>
        </div>

        <div style="display: none">
            <%if (user.provider == 'google') { %>
                <input id="providerId" type="text" value="<%= user.google.id %>">
            <% } %>
            <%if (user.provider == 'facebook') { %>
                <input id="providerId" type="text" value="<%= user.facebook.id %>">
            <% } %>
            <%if (user.provider == 'linkedin') { %>
                <input id="providerId" type="text" value="<%= user.linkedIn.id %>">
            <% } %>
            <%if (user.provider == 'twitter') { %>
                <input id="providerId" type="text" value="<%= user.twitter.id %>">
            <% } %>
            <p id="userProfileObject"> <%= JSON.stringify(user) %> </p>
        </div>

        <!-- RESUME SECTION -->
        <div id="wrapper" class="clearfix">

            <%# <p style="margin-left: 40%; color: #694905">Select all items you want to authenticate and click on Authenticate button</p>

            <p style="margin-left: 40%; color: #694905">Click <a data-toggle="modal" data-target="#authenticate-whole-user-profile" href="">here</a> to authenticate complete profile</p>%>

			<dialog id="authenticate-whole-user-profile" class="mdl-dialog">
		  		<h4 class="mdl-dialog__title">Authenticate <%=user.displayName%>'s Profile</h4>
			  	<div class="mdl-dialog__content">
			    	<p>Select all items that you want to authenticate, scroll down to bottom of the page, fill out the required information. and click on the Authenticate button.</p>
					<p>To authenticate the whole profile, click <a id="authenticateProfileAnchor" href="#contact">here</a>.</p>
			  	</div>
			  	<div class="mdl-dialog__actions">
			    	<button type="button" class="mdl-button ok-close">Ok</button>
			  	</div>
			</dialog>

            <section id="intro" class="clearfix section notopborder nomargin">
                <div class="container input-date-group">
                    <div class="row">
                        <div id="intro-img" class="col-md-3">
                            <div class="img-container" style="min-width: 250px; max-width: 250px;">
                                <img src="<%= user.image %>" class="center-content" alt="Avatar">
                            </div>

                        </div>
                        <div id="intro-profile" class="col-md-9 reduce-padding">
                            <div class="row form-horizontal">
                                <div class="col-sm-6"><h4 class="custom-heading">Hello, I'm</h4></div>
                                <div class="col-sm-12">
                                    <div class="mdl-textfield mdl-js-textfield full-width profile-name">
                                        <input class="mdl-textfield__input" type="text" id="introText1" value="<%= user.displayName %>" readonly>
                                        <label class="mdl-textfield__label" for="introText1">Full Name</label>
                                    </div>
                                </div>
                            </div>

							<div class="row">
                                <div class="col-sm-5-custom">
                                    <div class="mdl-textfield mdl-js-textfield full-width">
										<% if (user.profile && user.profile.introText) { %>
                                        	<input class="mdl-textfield__input" type="text" id="introText2" value="<%=user.profile.introText[1]%>" readonly>
										<% } else { %>
											<input class="mdl-textfield__input" type="text" id="introText2" value="" readonly>
										<% } %>
                                        <label class="mdl-textfield__label" for="introText2">Designer</label>
                                    </div>
                                </div>
                                <div class="col-sm-1" style="text-align: center; padding-top: 4px;">and</div>
                                <div class="col-sm-5-custom">
                                    <div class="mdl-textfield mdl-js-textfield full-width">
										<% if (user.profile && user.profile.introText) { %>
                                        	<input class="mdl-textfield__input" type="text" id="introText3" value="<%=user.profile.introText[2]%>" readonly>
										<% } else { %>
											<input class="mdl-textfield__input" type="text" id="introText3" value="" readonly>
										<% } %>
                                        <label class="mdl-textfield__label" for="introText3">Designer</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row topmargin-sm">
                                <div class="col-sm-12">
                                    <label>Opportunities I&#39;m seeking</label>
									<div class="row">
										<div class="col-lg-3 col-md-6 col-sm-6">
											<label class="mdl-radio mdl-js-radio mdl-js-ripple-effect" for="unPaidInternship">
										  		<input type="radio" id="unPaidInternship" class="mdl-radio__button" name="opportunityOption" value="unPaidInternship">
											  	<span class="mdl-radio__label radio-button-label radio-small">Unpaid Internship</span>
											</label>
                                        </div>
                                        <div class="col-lg-3 col-md-6 col-sm-6">
											<label class="mdl-radio mdl-js-radio mdl-js-ripple-effect" for="paidInternship">
										  		<input type="radio" id="paidInternship" class="mdl-radio__button" name="opportunityOption" value="paidInternship">
											  	<span class="mdl-radio__label radio-button-label radio-small">Paid Internship</span>
											</label>
                                        </div>
                                        <div class="col-lg-3 col-md-6 col-sm-6">
											<label class="mdl-radio mdl-js-radio mdl-js-ripple-effect" for="tempContract">
										  		<input type="radio" id="tempContract" class="mdl-radio__button" name="opportunityOption" value="tempContract">
											  	<span class="mdl-radio__label radio-button-label radio-small">Temporary Contract</span>
											</label>
                                        </div>
                                        <div class="col-lg-3 col-md-6 col-sm-6">
											<label class="mdl-radio mdl-js-radio mdl-js-ripple-effect" for="fullTimeHire">
										  		<input type="radio" id="fullTimeHire" class="mdl-radio__button" name="opportunityOption" value="fullTimeHire">
											  	<span class="mdl-radio__label radio-button-label radio-small">Full Time Hire</span>
											</label>
                                        </div>
                                    </div>
                            	</div>
                        </div>
                    </div>
                </div>
            </section>

            <div id="content" style="background-color: #F9F9F9;">
                <div id="content-wrap">
                    <div class="container-fluid clearfix" style="margin: 40px auto; padding: 0 20px;">

						<div class="row card-block">
                            <div class="col-sm-12 col-md-10 col-md-offset-1 col-lg-8 col-lg-offset-2">
                                <div class="demo-card-wide mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">About Me</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text input-date-group">
                                        <div class="row">
											<div class="col-sm-12">
												<div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label" style="width: 90%;">
                                                    <textarea class="mdl-textfield__input autoresize" type="text" rows="4" id="passion" maxlength="200" style="overflow: hidden; max-width:100%;" readonly><%= user.profile ? user.profile.passion : '' %></textarea>
                                                    <label class="mdl-textfield__label" for="passion">Describe your passion</label>
													<span class="mdl-textfield__error">Input must be defined!</span>
                                                </div>
                                            </div>
										</div>
										<div class="row">
											<div class="col-sm-4">
												<label class="custom-mdl-textfield__label" for="creativeRegion" style="">Region</label>
												<select id="creativeRegion" class="form-control select2-element" data-placeholder="Select a region">
												</select>
											</div>
										</div>
										<div class="row topmargin-sm">
			                                <div class="col-sm-12">
			                                    <label>Video Resume</label>
			                                    <div id="profile-video-show"></div>
			                                </div>
			                            </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row card-block">
                            <div class="col-sm-12 col-md-10 col-md-offset-1 col-lg-8 col-lg-offset-2">
                                <div class="mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">Skills</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text input-date-group">

                                        <ul class="skills row nopadding">

                                            <!-- Existing skills -->
											<% if (user.profile && user.profile.skills ) { %>
												<% for (var i = 0; i <= user.profile.skills.length; i++) {%>
													<% if (user.profile.skills[i]) { %>
														<div class="skill-item col-sm-6 hover-component verify-component" id="skill<%=i+1%>" data-category="skills">
															<div class="main-content">
																<div class="row">
																	<div class="col-sm-10">
																		<% if (user.profile.skills[i].verifiedCount > 0) { %>
																			<span id="skill-title<%=i+1%>" class="mdl-badge verify-badge skill-title" data-badge="<%=user.profile.skills[i].verifiedCount%>">
																				<%=user.profile.skills[i].skill%>
																			</span>
																			<div class="mdl-tooltip mdl-tooltip--top" data-mdl-for="skill-title<%=i+1%>">
																				Verified by <%=user.profile.skills[i].verifiedCount%> other(s)
																			</div>
																		<% } else { %>
																			<span id="skill-title<%=i+1%>" class="verify-badge skill-title" data-badge="">
																				<%=user.profile.skills[i].skill%>
																			</span>
																			<div class="mdl-tooltip mdl-tooltip--top" data-mdl-for="skill-title<%=i+1%>" style="display: none;">
																			</div>
																		<% } %>
																		<li data-percent="<%=user.profile.skills[i].rating%>">
																			<div class="progress nopadding">
																				<div class="progress-percent">
																					<div class="counter counter-inherit">
																						<span id="skill-range" class="skill-range" data-from="0" data-to="<%=user.profile.skills[i].rating%>" data-refresh-interval="30" data-speed="1100"></span>%
																					</div>
																				</div>
																			</div>
																		</li>
																	</div>
																</div>
															</div>
														</div>
													<% } %>
												<% } %>
											<% } %>
                                        </ul>
                                    </div>
									<div class="mdl-card__menu">
										<button id="verify-all-skill-button" class="mdl-button mdl-button--icon mdl-js-button mdl-js-ripple-effect verify-all">
											<i class="material-icons">verified_user</i>
										</button>
										<div class="mdl-tooltip" data-mdl-for="verify-all-skill-button">
											Verify all learning
										</div>
									</div>
                                </div>
                            </div>
                        </div>

                        <div class="row card-block">
                            <div class="col-sm-12 col-md-10 col-md-offset-1 col-lg-8 col-lg-offset-2">
                                <div class="mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">Projects</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text">
										<div class="row">
                                            <div class="col-sm-12 col-md-12 col-lg-12">
                                                <div id="project-timeline" class="timeline">
													<% if (user.profile && user.profile.experiences) {%>
														<% for (var i = 0; i <= user.profile.experiences.length; i++) {%>
															<% if (user.profile.experiences[i]) { %>
															<div class="project-item timeline-item hover-component verify-component" id="project<%=i+1%>" data-category="experiences">
																<div class="main-content">
																	<% if (user.profile.experiences[i].verifiedCount > 0) { %>
																	<span id="project-badge<%=i+1%>" class="verify-badge mdl-badge" data-badge="<%=user.profile.experiences[i].verifiedCount%>">
																		<h4 class="item-title"><%= user.profile.experiences[i].title%></h4>
																	</span>
																	<div class="mdl-tooltip mdl-tooltip--top" data-mdl-for="project-badge<%=i+1%>">
																		Verified by <%=user.profile.experiences[i].verifiedCount%> other(s)
																	</div>
																	<% } else { %>
																	<span id="project-badge<%=i+1%>" class="verify-badge" data-badge="">
																		<h4 class="item-title"><%= user.profile.experiences[i].title%></h4>
																	</span>
																	<div class="mdl-tooltip mdl-tooltip--top" data-mdl-for="project-badge<%=i+1%>" style="display: none;">
																	</div>
																	<% } %>
																	<span class="item-period"><%= user.profile.experiences[i].from %> - <%= user.profile.experiences[i].to %></span>
																	<p class="item-description"><%= user.profile.experiences[i].description %></p>
																</div>
															</div>
															<% } %>
														<% } %>
													<% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
									<div class="mdl-card__menu">
										<button id="verify-all-project-button" class="mdl-button mdl-button--icon mdl-js-button mdl-js-ripple-effect verify-all">
											<i class="material-icons">verified_user</i>
										</button>
										<div class="mdl-tooltip" data-mdl-for="verify-all-project-button">
											Verify all learning
										</div>
									</div>
                                </div>
                            </div>
                        </div>

						<div class="row">
							<div class="col-sm-6 col-md-5 col-md-offset-1 col-lg-4 col-lg-offset-2">
	                            <div class="card-block">
	                                <div class="mdl-card mdl-shadow--2dp">
	                                    <div class="mdl-card__title">
	                                        <h2 class="mdl-card__title-text">Learning</h2>
	                                    </div>
	                                    <div class="mdl-card__supporting-text">
	                                        <div class="row">
	                                            <div class="col-sm-12">
													<div id="learning-timeline" class="timeline">
														<% if (user.profile && user.profile.externalLinks) { %>
															<% for (var i = 0; i <= user.profile.externalLinks.length; i++) { %>
															<% if (user.profile.externalLinks[i]) { %>
																<div class="project-item timeline-item hover-component verify-component" id="learning<%=i+1%>" data-category="externalLinks">
																	<div class="main-content">
																		<% if (user.profile.externalLinks[i].verifiedCount > 0) { %>
																		<span id="learning-badge<%=i+1%>" class="verify-badge mdl-badge" data-badge="<%=user.profile.externalLinks[i].verifiedCount%>"
																			<h4 class="item-title"><%= user.profile.externalLinks[i].title%></h4>
																		</span>
																		<div class="mdl-tooltip mdl-tooltip-right" data-mdl-for="learning-badge<%=i+1%>">
																			Verified by <%=user.profile.externalLinks[i].verifiedCount%> other(s)
																		</div>
																		<% } else { %>
																		<span id="learning-badge<%=i+1%>" class="verify-badge" data-badge="">
																			<h4 class="item-title"><%= user.profile.externalLinks[i].title%></h4>
																		</span>
																		<div class="mdl-tooltip mdl-tooltip-right" data-mdl-for="learning-badge<%=i+1%>" style="display: none;">
																		</div>
																		<% } %>
																		<span class="item-period"><%= user.profile.externalLinks[i].from %> - <%= user.profile.externalLinks[i].to %></span>
																		<p class="item-description"><%= user.profile.externalLinks[i].description %></p>
																	</div>
																</div>
															<% } %>
															<% } %>
														<% } %>
													</div>
	                                            </div>
	                                        </div>
	                                    </div>
										<div class="mdl-card__menu">
											<button id="verify-all-learning-button" class="mdl-button mdl-button--icon mdl-js-button mdl-js-ripple-effect verify-all">
												<i class="material-icons">verified_user</i>
											</button>
											<div class="mdl-tooltip" data-mdl-for="verify-all-learning-button">
												Verify all learning
											</div>
										</div>
	                                </div>
	                            </div>
							</div>
							<div class="col-sm-6 col-md-5 col-lg-4">
								<div class="card-block">
									<div class="mdl-card mdl-shadow--2dp">
	                                    <div class="mdl-card__title">
	                                        <h2 class="mdl-card__title-text">Education</h2>
	                                    </div>
	                                    <div class="mdl-card__supporting-text">
	                                        <div class="row">
	                                            <div class="col-sm-12 col-md-12 col-lg-12">
	                                                <div id="education-timeline" class="timeline">
														<% if (user.profile && user.profile.educations) { %>
															<% for (var i = 0; i <= user.profile.educations.length; i++) { %>
																<% if (user.profile.educations[i]) { %>
																<div class="education-item timeline-item hover-component" id="edu<%=i+1%>">
																	<div class="main-content">
																	<h4 class="item-title"><%=user.profile.educations[i].degree%></h4>
																	<span class="item-institute"><%=user.profile.educations[i].institute%></span>
																	<span class="item-period"><%=user.profile.educations[i].from%> - <%=user.profile.educations[i].to%></span>
																	<p class="item-description"><%=user.profile.educations[i].description%></p>
																	</div>
																</div>
																<% } %>
															<% } %>
														<% } %>
	                                                </div>
	                                            </div>
	                                        </div>
	                                    </div>
	                                </div>
								</div>
                            </div>
                        </div>

						<div class="row card-block">
                            <div class="col-sm-12 col-md-10 col-md-offset-1 col-lg-8 col-lg-offset-2">
                                <div class="mdl-card mdl-shadow--2dp">
                                    <div class="mdl-card__title">
                                        <h2 class="mdl-card__title-text">Services</h2>
                                    </div>
                                    <div class="mdl-card__supporting-text">
										<div id="services-component" class="row">
										<% if (user.profile && user.profile.services) { %>
											<% for (var i = 0; i <= user.profile.services.length; i++) { %>
												<% if (user.profile.services[i]) { %>
												<div class="service-item col-sm-4 verify-component" id="service<%=i+1%>" data-category="services">
													<div class="main-content">
														<div class="feature-box fbox-center fbox-effect nobottomborder" data-animate="fadeIn">
															<% if (user.profile.services[i].verifiedCount > 0) { %>
															<div class="service-icon fbox-icon mdl-badge mdl-badge--overlap verify-badge" data-badge="<%=user.profile.services[i].verifiedCount%>">
																<i id="service-icon<%=i+1%>" class="fa <%=user.profile.services[i].icon%>"></i>
																<div class="mdl-tooltip mdl-tooltip--top" data-mdl-for="service-icon<%=i+1%>">
																	Verified by <%=user.profile.services[i].verifiedCount%> other(s)
																</div>
															</div>
															<% } else { %>
															<div class="service-icon fbox-icon verify-badge mdl-badge--overlap" data-badge="">
																<i id="service-icon<%=i+1%>" class="fa <%=user.profile.services[i].icon%>"></i>
																<div class="mdl-tooltip mdl-tooltip--top" data-mdl-for="service-icon<%=i+1%>"  style="display: none;">
																</div>
															</div>
															<% } %>
															<h3 class="service-title"><%=user.profile.services[i].service%></h3>
															<p class="service-desc"><%=user.profile.services[i].description%></p>
														</div>
													</div>
												</div>
												<% } %>
											<% }%>
										<% } %>
                                        </div>
