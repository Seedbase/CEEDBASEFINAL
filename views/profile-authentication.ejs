        <script text="text/javascript">

			$('.hover-component').on('mouseenter', function() {
				$(this).addClass('add-box-shadow');
			});

			$('.hover-component').on('mouseleave', function() {
				$(this).removeClass('add-box-shadow');
			});

            //Verification Badge
            $('.verify-component').on('click', function(e) {
                verifyComponent(e.currentTarget);
            });

			$('.verify-all').on('click', function(e) {
				var currentTarget = e.currentTarget;
				var verifyComponents = $(currentTarget.parentElement)
					.siblings('.mdl-card__supporting-text')
					.find('.verify-component');
				for (var i = 0; i < verifyComponents.length; i++) {
					verifyComponent(verifyComponents[i]);
				}
			});

			function verifyComponent(e) {
				var badge = $(e).find('.verify-badge');
				var tooltip = $(e).find('.mdl-tooltip');
				var verifiedCount = parseInt($(badge).attr('data-badge'));
				if (!verifiedCount) {
					verifiedCount = 0;
				}

				if ($(e).hasClass('verified')) {
					//Decrease verified count by 1
					verifiedCount--;

					//Get current verifiedCount
					$(badge).attr('data-badge', verifiedCount);

					if (verifiedCount > 0) {
						$(tooltip).text('Verified by ' + verifiedCount + ' other(s)');
						$(tooltip).css('display', 'block');
					} else {
						$(e).removeClass('verified');
						$(badge).removeClass('mdl-badge');
						$(tooltip).css('display', 'none');
					}

				} else {
					$(badge).addClass('mdl-badge');
					//Increase verified count by 1
					verifiedCount++;
					$(badge).attr('data-badge', verifiedCount);
					$(e).addClass('verified');

					if (verifiedCount > 1) {
						$(tooltip).text('Verified by you and ' + (verifiedCount - 1) + ' other(s)');
					} else {
						$(tooltip).text('Verified by you');
					}

					$(tooltip).css('display', 'block');
				}

				//Update verifiedCount property
				// var id = $(e).attr('id');
				// var elementCategory = $(e).attr('data-category');
				// var category;
				// var data;
                //
				// if (user.profile.hasOwnProperty(elementCategory)) {
				// 	category = user.profile[elementCategory.toString()];
				// 	for (var i = 0; i < category.length; i++) {
				// 		if (category[i].id === id) {
				// 			data = category[i];
				// 			break;
				// 		}
				// 	}
                //
				// 	if (data) {
				// 		data.verifiedCount = verifiedCount;
				// 	}
				// }
			}
        </script>

