                margin-bottom: 10px;
            }

            .custom-mdl-textfield__label {
                color: #3f51b5;
                font-size: 12px;
                top: 4px;
                visibility: visible;
                margin-bottom: 5px;
            }

            .profile-name .mdl-textfield__input {
                margin-bottom: 20px;
            }

            .profile-name {
                padding: 10px 0;
            }

            .mdl-card {
                width: 100%;
            }

            .profile-name input,
            .profile-name label {
                font-size: 46px;
                line-height: 46px;
            }

            @media (min-width: 768px) {
                .profile-3-things-col {
                    width: 30.55555556%;
                }
            }

            h4.custom-heading {
                font-size: 30px;
                text-align: left;
                margin-bottom: 0;
            }

            .full-width {
                width: 100%;
            }

            .card-block {
                padding: 20px 0;
            }

            .edit-content,
            .remove-content {
                display: none;
            }

            .mdl-card:hover .edit-remove-component {
                opacity: 1;
            }

            .edit-remove-component {
                position: absolute;
                top: -12px;
                right: -50px;
                opacity: 0;
            }

            .center-content {
                display: block;
                margin: 0 auto
            }

            /* -- Experiment from Bootstrap using flex -- */
            .row-eq-height {
                display: -webkit-box;
                display: -webkit-flex;
                display: -ms-flexbox;
                display: flex;
            }

            .hide-content {
                display: none;
            }

            /* --- Timeline --- */

            .timeline {
                border-left: 2px solid #e0e0e0;
                padding: 15px 0;
            }

            .timeline-item {
                position: relative;
                padding: 15px 20px 10px;
                margin-left: 20px;
                margin-bottom: 20px;
                background-color: #fff;
                border-left: 2px solid #1BBC9C;
                /*box-shadow: 0px 0px 3px 0px rgba(0,0,0,0.2);*/
            }

            .timeline-item:hover {
                box-shadow: 0px 0px 8px 0px rgba(0,0,0,0.2);
            }

            .timeline-item:hover .edit-content,
            .timeline-item:hover .remove-content {
                display: inline-block;
            }

            .timeline-item:last-child {
                margin-bottom: 0;
            }

            .timeline-item:before {
                content: '';
                display: inline-block;
                position: absolute;
                background-color: #1BBC9C;
                border-radius: 10px;
                width: 12px;
                height: 12px;
                top: 20px;
                left: -29px;
                border: 2px solid #1BBC9C;
                z-index: 2;
            }

            .timeline-item:after {
                content: '';
                display: inline-block;
                position: absolute;
                background-color: #1BBC9C;
                border-radius: 10px;
                width: 29px;
                height: 2px;
                top: 25px;
                left: -29px;
                z-index: 1;
            }

            .timeline-item .item-title {
                display: block;
                margin: 0;
                font-size: 16px;
                line-height: 1.2em;
            }

            /** Added **/
            .timeline-item .item-edit {
                top: 15px;
                right: 20px;
                position: absolute;
            }

            .timeline-item .item-period {
                display: inline-block;
                font-size: 12px;
                line-height: 1.2em;
                color: #2eca7f;
                margin-bottom: 8px;
            }

            .timeline-item .item-small {
                display: inline-block;
                font-size: 12px;
                line-height: 1.2em;
                color: #9e9e9e;
                margin-left: 5px;
                margin-bottom: 8px;
                padding-left: 8px;
                border-left: 1px solid #e0e0e0;
            }

            /* --- Services --- */

            .feature-box.fbox-center {
                padding: 20px;
            }

            .service-edit {
                position: absolute;
                top: 20px;
                right: 20px;
            }

        </style>

