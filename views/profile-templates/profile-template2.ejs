<!DOCTYPE html>
<html lang="en">
    <head>
        <link rel="stylesheet" href="css/bootstrap.min.css" type="text/css"/>
        <link rel="stylesheet" href="css/style-updated.css" type="text/css" />
        <link rel="stylesheet" href="css/dark.css" type="text/css" />
        <link rel="stylesheet" href="css/font-icons.css" type="text/css" />
        <link rel="stylesheet" href="css/animate.css" type="text/css" />
        <link rel="stylesheet" href="css/magnific-popup.css" type="text/css" />
        <link rel="stylesheet" href="css/font-awesome.min.css">

        <!-- Date Picker CSS -->
        <link rel="stylesheet" href="css/canvas-components/datepicker.css" type="text/css" />

        <!-- Select Boxes CSS -->
        <link rel="stylesheet" href="css/canvas-components/select-boxes.css" type="text/css" />

        <link rel="stylesheet" href="css/responsive.css" type="text/css" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
    </head>
    <body class="stretched">
        <div id="wrapper" class="clearfix">
            <section id="intro" class="with-header clearfix section notopborder nomargin">
                <div id="intro-profile" class="center">
                    <img src="images/profile/avatar.jpg" class="img-circle" alt="Avatar" style="max-width: 140px;">
                    <div class="heading-block noborder topmargin-sm">
                        <h2>Welcome, Name</h2>
                    </div>
                </div>
                <div id="intro-tell-us" class="center">
                    <div class="heading-block noborder">
                        <h4>Introduce Yourself</h4>
                    </div>
                    <a href="#" data-scrollto="#about" class="one-page-arrow">
                        <i class="icon-angle-down infinite animated fadeInDown"></i>
                    </a>
                </div>
            </section>
            <header id="header" class="full-header" data-sticky-class="not-dark">
                <div id="header-wrap">
                    <div class="container clearfix">
                        <div id="primary-menu-trigger"><i class="icon-reorder"></i></div>

                        <div id="logo"></div>

                        <nav id="primary-menu" class="dark">
                            <ul class="one-page-menu" data-easing="easeInOutExpo" data-speed="1500">
                                <li><a href="#about"><div>About</div></a></li>
                                <li><a href="#skills"><div>Skills</div></a></li>
                                <li><a href="#video"><div>Video</div></a></li>
                                <li><a href="#portfolio"><div>Portfolio</div></a></li>
                                <li><a href="#experience"><div>Experience</div></a></li>
                                <li><a href="#education"><div>Education</div></a></li>
                                <li><a href="#references"><div>References</div></a></li>
                                <li><a href="#contact"><div>Contact</div></a></li>
                            </ul>
                            <div id="side-panel-trigger" class="side-panel-trigger"><a href="#"><i class="icon-user"></i></a></div>
                        </nav>
                    </div>
                </div>
            </header>

            <div class="clear"></div>

            <section id="content">

                <div class="content-wrap">

                    <section id="about" class="page-section">

                        <div class="container clearfix input-date-group">

                            <div class="heading-block center">
                                <h2>About</h2>
                                <span>What I am all about</span>
                            </div>

                            <div class="row">
                                <div class="form-group col-sm-12">
                                    <label for="exampleTextarea">Describe yourself</label>
                                    <textarea class="form-control" id="exampleTextarea" rows="5" maxlength="200" style="resize: vertical;"></textarea>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group col-sm-6">
                                    <label for="about-name">Name</label>
                                    <input type="text" class="form-control" id="about-name" placeholder="Enter name">
                                </div>

                                <div class="form-group col-sm-6">
                                    <label for="about-email">Email address</label>
                                    <input type="email" class="form-control" id="about-email" aria-describedby="emailHelp" placeholder="Enter email">
                                    <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group col-sm-4">
                                    <label for="about-birthday">Birthday</label>
                                    <input id="about-birthday" type="text" value="" class="form-control tleft mnth" placeholder="MM-YYYY">
                                </div>
                                <div class="form-group col-sm-4">
                                    <label for="about-region">Region</label>
                                    <select id="about-region" class="select-1 form-control" style="width:100%;">
                                        <optgroup label="Ontario">
                                            <option value="OTT">Ottawa</option>
                                            <option value="TOR">Toronto</option>
                                            <option value="NIA">Niagara Falls</option>
                                        </optgroup>
                                        <optgroup label="Quebec">
                                            <option value="MON">Montreal</option>
                                        </optgroup>
                                        <optgroup label="British Columbia">
                                            <option value="VAN">Vancouver</option>
                                        </optgroup>
                                    </select>
                                </div>
                            </div>

                            <div class="clear"></div>

                        </div>

                    </section>

                    <div class="divider divider-center divider-short"><i class="icon-circle"></i></div>

                    <section id="skills" class="page-section">

                        <div class="container clearfix">

                            <div class="heading-block center">
                                <h2>Skills</h2>
                                <span>My skills</span>
                            </div>

                        </div>

                    </section>

                </div>

            </section><!-- #content end -->
        </div>

        <!-- Go To Top
	    ============================================= -->
        <div id="gotoTop" class="icon-angle-up"></div>

        <script type="text/javascript" src="js/jquery.js"></script>
        <script type="text/javascript" src="js/plugins.js"></script>
        <script type="text/javascript" src="js/functions.js"></script>

        <!-- Date Picker JS -->
        <script type="text/javascript" src="js/canvas-components/datepicker.js"></script>

        <!-- Select Boxes JS -->
        <script type="text/javascript" src="js/canvas-components/select-boxes.js"></script>
        <script src="plugins/select2/dist/js/select2.min.js"></script>

        <script>

            SEMICOLON.documentOnResize.fullScreenProfile = function() {
                var intro = jQuery('#intro');
                jQuery(intro).each( function(){
                    var element = jQuery(this),
                        scrHeight = window.innerHeight ? window.innerHeight : jQuery(window).height(),
                        negativeHeight = element.attr('data-negative-height');

                    if( jQuery('.with-header').next('#header:not(.transparent-header)').length > 0 && ( jQuery('body').hasClass('device-lg') || jQuery('body').hasClass('device-md') ) ) {
                        var headerHeightOff = jQuery('#header').outerHeight();
                        scrHeight = scrHeight - headerHeightOff;
                    }
                    if( element.parents('.full-screen').length > 0 ) { scrHeight = element.parents('.full-screen').height(); }

                    if( jQuery('body').hasClass('device-xs') || jQuery('body').hasClass('device-xxs') ) {
                        if( !element.hasClass('force-full-screen') ){ scrHeight = 'auto'; }
                    }

                    if( negativeHeight ){ scrHeight = scrHeight - Number(negativeHeight); }

                    element.css('height', scrHeight);
                });
            }
            jQuery(window).on('load resize', SEMICOLON.documentOnResize.fullScreenProfile);


            jQuery('.input-date-group .mnth').datepicker({
                autoclose: true,
                minViewMode: 1,
                format: "mm/yy"
            });

        </script>
    </body>
</html>
