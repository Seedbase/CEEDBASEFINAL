				<script>


						//On pencil icon click
						$('.edit-control').on('click', function() {
							var parent = $(this).parent();
							var contentDiv = $(parent).siblings('.edit-content');
							var displayDiv = $(parent).siblings('.edit-display');
							var allInputs = $(contentDiv).find(':input');

							$(allInputs).each(function() {
								if ($(this).is("input")) {
									$(this).val($(displayDiv).text());
								}
							});

							$(displayDiv).css('display', 'none');
							$(contentDiv).css('display', 'block');
							$(this).css('display', 'none');

						});

						$('.edit-save').on('click', function() {
							var contentDiv = $(this).parent();
							var displayDiv = $(contentDiv).siblings('.edit-display');
							var label = $(contentDiv).siblings('label');
							var allInputs = $(contentDiv).find(':input');

							$(allInputs).each(function() {
								if ($(this).is("input")) {
									$(displayDiv).text($(this).val());
								}
							});

							$(label).find('.edit-control').css('display', 'inline-block');
							$(contentDiv).css('display', 'none');
							$(displayDiv).css('display', 'block');

						});

