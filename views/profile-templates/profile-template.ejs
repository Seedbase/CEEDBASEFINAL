            <style>
                .side-panel-trigger-left {
                    float: left !important;
                }

                #dock-trigger,
                #dock-trigger i { display: none; }

                .side-panel-left #dock-trigger {
                    display: block;
                    position: fixed;
                    cursor: pointer;
                    top: 20px;
                    left: 20px;
                    z-index: 399;
                    font-size: 16px;
                    width: 32px;
                    height: 32px;
                    line-height: 32px;
                    background-color: #FFF;
                    text-align: center;
                    border-radius: 2px;
                }

                .side-panel-open #dock-trigger { left: 320px; }

                .side-panel-left #dock-trigger,
                .side-panel-left #dock-trigger i { display: none; }

                .side-panel-left.side-panel-open #dock-trigger,
                .side-panel-left.side-panel-open #dock-trigger i { display: block; }

                .side-panel-open #dock-trigger {
                    -webkit-transition: left .4s ease;
                    -o-transition: left .4s ease;
                    transition: left .4s ease;
                }

                .side-panel-open #wrapper.docked {
                    left: 300px;
                    overflow-x: visible;
                }

                .primary-menu-left {
                    float: left!important;
                }
            </style>
